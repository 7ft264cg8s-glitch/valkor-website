on\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"Valkor Systems\",\"url\":\"https://www.valkorsystems.com\",\"logo\":\"https://www.valkorsystems.com/valkor-logo.png\",\"email\":\"jackson@valkorsystems.com\"}</script><header class=\"fixed inset-x-0 top-0 z-[100] border-b border-slate-200/70 bg-white/95 shadow-sm shadow-slate-200/40 backdrop-blur-2xl\"><nav class=\"mx-auto flex h-[4.5rem] max-w-7xl items-center justify-between px-5 sm:px-6 lg:px-8\"><a class=\"flex items-center gap-3\" aria-label=\"Valkor Systems home\" href=\"/\"><img alt=\"Valkor Systems\" width=\"156\" height=\"45\" decoding=\"async\" data-nimg=\"1\" class=\"h-8 w-auto object-contain contrast-125 saturate-110 brightness-95\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fvalkor-logo.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fvalkor-logo.png&amp;w=384&amp;q=75 2x\" src=\"/_next/image?url=%2Fvalkor-logo.png&amp;w=384&amp;q=75\"/></a><div class=\"hidden items-center gap-6 lg:flex\"><a class=\"rounded-full px-1 py-2 text-sm font-semibold text-slate-600 transition duration-200 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-cyan-500/70 focus:ring-offset-4\" href=\"/#what-valkor-does\">Product</a><a class=\"rounded-full px-1 py-2 text-sm font-semibold text-slate-600 transition duration-200 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-cyan-500/70 focus:ring-offset-4\" href=\"/pilot\">Pilot Program</a><a class=\"rounded-full px-1 py-2 text-sm font-semibold text-slate-600 transition duration-200 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-cyan-500/70 focus:ring-offset-4\" href=\"/trust-center\">Trust &amp; Privacy</a><a class=\"rounded-full px-1 py-2 text-sm font-semibold text-slate-600 transition duration-200 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-cyan-500/70 focus:ring-offset-4\" href=\"/it-security\">Technical Overview</a><a class=\"rounded-full px-1 py-2 text-sm font-semibold text-slate-600 transition duration-200 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-cyan-500/70 focus:ring-offset-4\" href=\"/#request-pilot\">Request Pilot</a></div><div class=\"hidden lg:block\"><a class=\"inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition duration-300 focus:outline-none focus:ring-2 focus:ring-orange-500/70 focus:ring-offset-2 focus:ring-white border border-orange-500/20 bg-orange-600 text-white shadow-lg shadow-orange-600/20 hover:bg-orange-700 hover:shadow-xl hover:shadow-orange-600/25 active:translate-y-px px-4 py-2.5 text-[13px] shadow-md shadow-orange-600/15 hover:shadow-lg hover:shadow-orange-600/20\" href=\"/#request-pilot\">Limited Pilot Review</a></div><button type=\"button\" class=\"inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-white/90 text-slate-800 shadow-sm shadow-slate-200/70 backdrop-blur focus:outline-none focus:ring-2 focus:ring-cyan-500/70 focus:ring-offset-2 lg:hidden\" aria-label=\"Toggle navigation\" aria-expanded=\"false\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu h-5 w-5\"><line x1=\"4\" x2=\"20\" y1=\"12\" y2=\"12\"></line><line x1=\"4\" x2=\"20\" y1=\"6\" y2=\"6\"></line><line x1=\"4\" x2=\"20\" y1=\"18\" y2=\"18\"></line></svg></button></nav></header><div aria-hidden=\"true\" class=\"h-[4.5rem]\"></div><main><section class=\"relative isolate overflow-hidden bg-[#fbfaf8] px-5 pb-20 pt-14 sm:px-6 sm:pb-28 sm:pt-20 lg:px-8 lg:pt-24\"><div class=\"hero-orb pointer-events-none absolute left-1/2 top-28 h-[42rem] w-[58rem] -translate-x-1/2 rounded-full bg-orange-300/25 blur-[130px]\"></div><div class=\"pointer-events-none absolute inset-x-0 top-0 h-64 bg-[radial-gradient(circle_at_50%_0%,rgba(255,255,255,1),transparent_68%)]\"></div><div class=\"relative mx-auto max-w-7xl\"><div class=\"mx-auto max-w-5xl text-center\" style=\"opacity:0;transform:translateY(18px)\"><p class=\"inline-flex items-center gap-2 rounded-full border border-slate-200/80 bg-white/80 px-4 py-2 text-xs font-bold uppercase tracking-[0.17em] text-slate-600 shadow-sm backdrop-blur\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-dot h-3.5 w-3.5 text-orange-600\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><circle cx=\"12\" cy=\"12\" r=\"1\"></circle></svg>School operations, made visible</p><h1 class=\"mt-7 text-balance text-[clamp(3.35rem,8.6vw,7.8rem)] font-semibold leading-[0.88] tracking-[-0.067em] text-slate-950\">School-controlled<span class=\"block text-slate-400\">operational awareness.</span></h1><p class=\"mx-auto mt-7 max-w-3xl text-balance text-lg leading-8 text-slate-600 sm:text-xl sm:leading-9\">Review movement exceptions, pass activity, receiver health, and incident follow-up from one calm school-hours command center.</p><div class=\"mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row\"><a class=\"inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition duration-300 focus:outline-none focus:ring-2 focus:ring-orange-500/70 focus:ring-offset-2 focus:ring-white border border-orange-500/20 bg-orange-600 text-white shadow-lg shadow-orange-600/20 hover:bg-orange-700 hover:shadow-xl hover:shadow-orange-600/25 active:translate-y-px w-full px-7 py-3.5 sm:w-auto\" href=\"#request-pilot\">Request Pilot Review<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a class=\"inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition duration-300 focus:outline-none focus:ring-2 focus:ring-orange-500/70 focus:ring-offset-2 focus:ring-white border border-slate-200/80 bg-white/[0.88] text-slate-900 shadow-sm shadow-slate-200/60 backdrop-blur hover:border-slate-300 hover:bg-white hover:shadow-md active:translate-y-px w-full px-7 py-3.5 sm:w-auto\" href=\"#demo\">View Product Demo</a></div><p class=\"mt-5 text-sm font-medium text-slate-500\">School-hours use. Approved staff only. Human-reviewed follow-up.</p></div><div class=\"relative mx-auto mt-16 max-w-[78rem] sm:mt-20\" style=\"opacity:0;transform:translateY(44px) scale(0.97)\"><div class=\"absolute inset-x-[8%] bottom-[-4%] h-36 rounded-[50%] bg-orange-500/20 blur-[75px]\"></div><div class=\"overflow-hidden rounded-[1.35rem] border border-white/10 bg-[#07101a] shadow-[0_38px_100px_rgba(2,6,23,0.34)] ring-1 ring-slate-950/10 sm:rounded-[1.75rem] relative\"><div class=\"flex h-11 items-center justify-between border-b border-white/10 bg-[#0b121d] px-4\"><div class=\"flex items-center gap-1.5\" aria-hidden=\"true\"><span class=\"h-2.5 w-2.5 rounded-full bg-[#ff6b56]\"></span><span class=\"h-2.5 w-2.5 rounded-full bg-[#ffbd2e]\"></span><span class=\"h-2.5 w-2.5 rounded-full bg-[#27c93f]\"></span></div><div class=\"flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-400 sm:text-xs\"><span class=\"relative flex h-2.5 w-2.5\" aria-hidden=\"true\"><span class=\"absolute inline-flex h-full w-full animate-ping rounded-full opacity-25 bg-emerald-400 shadow-emerald-400/50\"></span><span class=\"relative inline-flex h-2.5 w-2.5 rounded-full shadow-[0_0_14px_currentColor] bg-emerald-400 shadow-emerald-400/50\"></span></span>Command center online</div></div><img alt=\"Valkor command center showing the highest-priority school operations state, receiver health, confidence, and assigned response.\" width=\"1800\" height=\"1015\" decoding=\"async\" data-nimg=\"1\" class=\"aspect-[16/9] w-full object-cover object-left-top\" style=\"color:transparent\" sizes=\"(min-width: 1280px) 1180px, 94vw\" srcSet=\"/_next/image?url=%2Fproduct%2Foverview.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fproduct%2Foverview.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fproduct%2Foverview.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fproduct%2Foverview.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fproduct%2Foverview.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fproduct%2Foverview.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fproduct%2Foverview.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fproduct%2Foverview.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fproduct%2Foverview.png&amp;w=3840&amp;q=75\"/></div><div class=\"absolute hidden min-w-44 rounded-2xl border border-white/80 bg-white/90 p-4 shadow-[0_18px_55px_rgba(15,23,42,0.16)] backdrop-blur-xl md:block left-2 top-10 xl:-left-10\" style=\"opacity:0;transform:translateY(14px)\"><p class=\"text-[10px] font-bold uppercase tracking-[0.18em] text-slate-400\">Top priority</p><p class=\"mt-1.5 flex items-center gap-2 text-sm font-semibold text-slate-950\"><span class=\"relative flex h-2.5 w-2.5\" aria-hidden=\"true\"><span class=\"absolute inline-flex h-full w-full animate-ping rounded-full opacity-25 bg-orange-500 shadow-orange-500/50\"></span><span class=\"relative inline-flex h-2.5 w-2.5 rounded-full shadow-[0_0_14px_currentColor] bg-orange-500 shadow-orange-500/50\"></span></span>Route exception</p></div><div class=\"absolute hidden min-w-44 rounded-2xl border border-white/80 bg-white/90 p-4 shadow-[0_18px_55px_rgba(15,23,42,0.16)] backdrop-blur-xl md:block right-2 top-24 xl:-right-10\" style=\"opacity:0;transform:translateY(14px)\"><p class=\"text-[10px] font-bold uppercase tracking-[0.18em] text-slate-400\">Receiver health</p><p class=\"mt-1.5 flex items-center gap-2 text-sm font-semibold text-slate-950\"><span class=\"relative flex h-2.5 w-2.5\" aria-hidden=\"true\"><span class=\"absolute inline-flex h-full w-full animate-ping rounded-full opacity-25 bg-emerald-400 shadow-emerald-400/50\"></span><span class=\"relative inline-flex h-2.5 w-2.5 rounded-full shadow-[0_0_14px_currentColor] bg-emerald-400 shadow-emerald-400/50\"></span></span>41 online</p></div><div class=\"absolute hidden min-w-44 rounded-2xl border border-white/80 bg-white/90 p-4 shadow-[0_18px_55px_rgba(15,23,42,0.16)] backdrop-blur-xl md:block bottom-24 left-8 xl:-left-2\" style=\"opacity:0;transform:translateY(14px)\"><p class=\"text-[10px] font-bold uppercase tracking-[0.18em] text-slate-400\">Signal confidence</p><p class=\"mt-1.5 flex items-center gap-2 text-sm font-semibold text-slate-950\"><span class=\"relative flex h-2.5 w-2.5\" aria-hidden=\"true\"><span class=\"absolute inline-flex h-full w-full animate-ping rounded-full opacity-25 bg-orange-500 shadow-orange-500/50\"></span><span class=\"relative inline-flex h-2.5 w-2.5 rounded-full shadow-[0_0_14px_currentColor] bg-orange-500 shadow-orange-500/50\"></span></span>High · fresh</p></div><div class=\"absolute hidden min-w-44 rounded-2xl border border-white/80 bg-white/90 p-4 shadow-[0_18px_55px_rgba(15,23,42,0.16)] backdrop-blur-xl md:block bottom-14 right-6 xl:-right-4\" style=\"opacity:0;transform:translateY(14px)\"><p class=\"text-[10px] font-bold uppercase tracking-[0.18em] text-slate-400\">Staff response</p><p class=\"mt-1.5 flex items-center gap-2 text-sm font-semibold text-slate-950\"><span class=\"relative flex h-2.5 w-2.5\" aria-hidden=\"true\"><span class=\"absolute inline-flex h-full w-full animate-ping rounded-full opacity-25 bg-orange-500 shadow-orange-500/50\"></span><span class=\"relative inline-flex h-2.5 w-2.5 rounded-full shadow-[0_0_14px_currentColor] bg-orange-500 shadow-orange-500/50\"></span></span>Assigned</p></div></div></div></section><section class=\"bg-white px-5 py-24 sm:px-6 lg:px-8 lg:py-32\"><div class=\"mx-auto max-w-7xl\"><div class=\"mx-auto max-w-3xl text-center\" style=\"opacity:0;transform:translateY(22px)\"><p class=\"text-xs font-bold uppercase tracking-[0.24em] text-orange-600\">The operational gap</p><h2 class=\"mt-4 text-balance text-4xl font-semibold tracking-[-0.045em] sm:text-5xl lg:text-6xl text-slate-950\">Schools do not need more alerts. They need one shared state.</h2><p class=\"mt-5 text-balance text-base leading-8 sm:text-lg text-slate-600\">Valkor turns disconnected building signals into a calm, reviewable workflow.</p></div><div class=\"mt-16 grid gap-px overflow-hidden rounded-[2rem] border border-slate-200 bg-slate-200 shadow-sm lg:grid-cols-3\"><div class=\"bg-white p-7 sm:p-9\" style=\"opacity:0;transform:translateY(18px)\"><span class=\"text-sm font-semibold text-orange-600\">0<!-- -->1</span><h3 class=\"mt-8 text-2xl font-semibold tracking-tight text-slate-950\">Fragmented inputs</h3><p class=\"mt-3 max-w-sm text-sm leading-7 text-slate-600\">Passes, radios, attendance, and staff follow-up live in different places.</p></div><div class=\"bg-white p-7 sm:p-9\" style=\"opacity:0;transform:translateY(18px)\"><span class=\"text-sm font-semibold text-orange-600\">0<!-- -->2</span><h3 class=\"mt-8 text-2xl font-semibold tracking-tight text-slate-950\">Unclear ownership</h3><p class=\"mt-3 max-w-sm text-sm leading-7 text-slate-600\">Exceptions become noise when no one can see who is responding.</p></div><div class=\"bg-white p-7 sm:p-9\" style=\"opacity:0;transform:translateY(18px)\"><span class=\"text-sm font-semibold text-orange-600\">0<!-- -->3</span><h3 class=\"mt-8 text-2xl font-semibold tracking-tight text-slate-950\">Weak proof</h3><p class=\"mt-3 max-w-sm text-sm leading-7 text-slate-600\">Schools need reliability evidence before deciding to expand a pilot.</p></div></div></div></section><section id=\"what-valkor-does\" class=\"relative overflow-hidden bg-[#f3f0ec] px-5 py-24 sm:px-6 lg:px-8 lg:py-32\"><div class=\"mx-auto max-w-7xl\"><div class=\"mx-auto max-w-3xl text-center\" style=\"opacity:0;transform:translateY(22px)\"><p class=\"text-xs font-bold uppercase tracking-[0.24em] text-orange-600\">Product proof</p><h2 class=\"mt-4 text-balance text-4xl font-semibold tracking-[-0.045em] sm:text-5xl lg:text-6xl text-slate-950\">The command center is the centerpiece.</h2><p class=\"mt-5 text-balance text-base leading-8 sm:text-lg text-slate-600\">Priority, system confidence, pass context, and staff ownership stay together—so leaders can scan first and investigate second.</p></div><div class=\"relative mt-16\" style=\"opacity:0;transform:translateY(36px)\"><div class=\"absolute inset-x-[8%] -top-8 h-56 rounded-full bg-orange-400/20 blur-[100px]\"></div><div class=\"overflow-hidden rounded-[1.35rem] border border-white/10 bg-[#07101a] shadow-[0_38px_100px_rgba(2,6,23,0.34)] ring-1 ring-slate-950/10 sm:rounded-[1.75rem] relative\"><div class=\"flex h-11 items-center justify-between border-b border-white/10 bg-[#0b121d] px-4\"><div class=\"flex items-center gap-1.5\" aria-hidden=\"true\"><span class=\"h-2.5 w-2.5 rounded-full bg-[#ff6b56]\"></span><span class=\"h-2.5 w-2.5 rounded-full bg-[#ffbd2e]\"></span><span class=\"h-2.5 w-2.5 rounded-full bg-[#27c93f]\"></span></div><div class=\"flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-400 sm:text-xs\"><span class=\"relative flex h-2.5 w-2.5\" aria-hidden=\"true\"><span class=\"absolute inline-flex h-full w-full animate-ping rounded-full opacity-25 bg-emerald-400 shadow-emerald-400/50\"></span><span class=\"relative inline-flex h-2.5 w-2.5 rounded-full shadow-[0_0_14px_currentColor] bg-emerald-400 shadow-emerald-400/50\"></span></span>Command center online</div></div><img alt=\"Valkor operational awareness screen showing movement exceptions, incident context, staff response, and action history.\" loading=\"lazy\" width=\"1800\" height=\"1015\" decoding=\"async\" data-nimg=\"1\" class=\"aspect-[16/9] w-full object-cover object-left-top\" style=\"color:transparent\" sizes=\"(min-width: 1280px) 1180px, 94vw\" srcSet=\"/_next/image?url=%2Fproduct%2Foperational-awareness.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fproduct%2Foperational-awareness.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fproduct%2Foperational-awareness.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fproduct%2Foperational-awareness.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fproduct%2Foperational-awareness.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fproduct%2Foperational-awareness.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fproduct%2Foperational-awareness.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fproduct%2Foperational-awareness.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fproduct%2Foperational-awareness.png&amp;w=3840&amp;q=75\"/></div><div class=\"relative mx-auto -mt-1 grid max-w-5xl gap-px overflow-hidden rounded-b-[1.5rem] border border-slate-200 bg-slate-200 shadow-xl sm:grid-cols-3\"><div class=\"bg-white px-6 py-5\"><p class=\"text-sm font-semibold text-slate-950\">Priority before volume</p><p class=\"mt-1 text-xs leading-5 text-slate-500\">The next issue to review stays obvious.</p></div><div class=\"bg-white px-6 py-5\"><p class=\"text-sm font-semibold text-slate-950\">Context before action</p><p class=\"mt-1 text-xs leading-5 text-slate-500\">Confidence and freshness travel with each event.</p></div><div class=\"bg-white px-6 py-5\"><p class=\"text-sm font-semibold text-slate-950\">Ownership to outcome</p><p class=\"mt-1 text-xs leading-5 text-slate-500\">Assignment and follow-up remain visible.</p></div></div></div></div></section><section class=\"overflow-hidden bg-white px-5 py-24 sm:px-6 lg:px-8 lg:py-36\"><div class=\"mx-auto grid max-w-7xl gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24\"><div><div class=\"lg:sticky lg:top-32\"><div class=\"max-w-2xl\" style=\"opacity:0;transform:translateY(22px)\"><p class=\"text-xs font-bold uppercase tracking-[0.24em] text-orange-600\">Signal to decision</p><h2 class=\"mt-4 text-balance text-4xl font-semibold tracking-[-0.045em] sm:text-5xl lg:text-6xl text-slate-950\">Infrastructure in. Human judgment out.</h2><p class=\"mt-5 text-balance text-base leading-8 sm:text-lg text-slate-600\">Every step adds context without pretending a signal is a decision.</p></div><div class=\"mt-9 hidden items-center gap-3 text-sm font-semibold text-slate-500 lg:flex\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-down h-4 w-4 text-orange-600\" aria-hidden=\"true\"><path d=\"M12 5v14\"></path><path d=\"m19 12-7 7-7-7\"></path></svg>Follow the live system path</div></div></div><div class=\"relative\"><div class=\"absolute bottom-10 left-[1.65rem] top-10 w-px bg-gradient-to-b from-orange-400 via-orange-300 to-slate-200 sm:left-[2.15rem]\"></div><div class=\"space-y-5\"><article class=\"group relative rounded-[1.6rem] border border-slate-200 bg-white p-5 pl-[5rem] shadow-sm transition duration-500 hover:-translate-y-0.5 hover:border-orange-200 hover:shadow-[0_24px_65px_rgba(249,115,22,0.1)] sm:p-7 sm:pl-[6.5rem]\" style=\"opacity:0.35;transform:translateX(22px)\"><div class=\"absolute left-3.5 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-2xl border border-orange-200 bg-orange-50 text-orange-600 shadow-[0_0_0_8px_white] transition group-hover:bg-orange-600 group-hover:text-white sm:left-5 sm:h-12 sm:w-12\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-id-card h-5 w-5\" aria-hidden=\"true\"><path d=\"M16 10h2\"></path><path d=\"M16 14h2\"></path><path d=\"M6.17 15a3 3 0 0 1 5.66 0\"></path><circle cx=\"9\" cy=\"11\" r=\"2\"></circle><rect x=\"2\" y=\"5\" width=\"20\" height=\"14\" rx=\"2\"></rect></svg></div><div class=\"flex items-start justify-between gap-5\"><div><p class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-orange-600\">Step <!-- -->01</p><h3 class=\"mt-2 text-xl font-semibold tracking-tight text-slate-950\">Approved badge</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">A school-issued badge transmits inside the approved school-hours window.</p></div><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-1 hidden h-5 w-5 shrink-0 text-slate-300 transition group-hover:text-orange-500 sm:block\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg></div></article><article class=\"group relative rounded-[1.6rem] border border-slate-200 bg-white p-5 pl-[5rem] shadow-sm transition duration-500 hover:-translate-y-0.5 hover:border-orange-200 hover:shadow-[0_24px_65px_rgba(249,115,22,0.1)] sm:p-7 sm:pl-[6.5rem]\" style=\"opacity:0.35;transform:translateX(22px)\"><div class=\"absolute left-3.5 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-2xl border border-orange-200 bg-orange-50 text-orange-600 shadow-[0_0_0_8px_white] transition group-hover:bg-orange-600 group-hover:text-white sm:left-5 sm:h-12 sm:w-12\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-radio h-5 w-5\" aria-hidden=\"true\"><path d=\"M4.9 19.1C1 15.2 1 8.8 4.9 4.9\"></path><path d=\"M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5\"></path><circle cx=\"12\" cy=\"12\" r=\"2\"></circle><path d=\"M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5\"></path><path d=\"M19.1 4.9C23 8.8 23 15.1 19.1 19\"></path></svg></div><div class=\"flex items-start justify-between gap-5\"><div><p class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-orange-600\">Step <!-- -->02</p><h3 class=\"mt-2 text-xl font-semibold tracking-tight text-slate-950\">Receiver detects zone</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">School-controlled infrastructure identifies a defined building area.</p></div><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-1 hidden h-5 w-5 shrink-0 text-slate-300 transition group-hover:text-orange-500 sm:block\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg></div></article><article class=\"group relative rounded-[1.6rem] border border-slate-200 bg-white p-5 pl-[5rem] shadow-sm transition duration-500 hover:-translate-y-0.5 hover:border-orange-200 hover:shadow-[0_24px_65px_rgba(249,115,22,0.1)] sm:p-7 sm:pl-[6.5rem]\" style=\"opacity:0.35;transform:translateX(22px)\"><div class=\"absolute left-3.5 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-2xl border border-orange-200 bg-orange-50 text-orange-600 shadow-[0_0_0_8px_white] transition group-hover:bg-orange-600 group-hover:text-white sm:left-5 sm:h-12 sm:w-12\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-wifi h-5 w-5\" aria-hidden=\"true\"><path d=\"M12 20h.01\"></path><path d=\"M2 8.82a15 15 0 0 1 20 0\"></path><path d=\"M5 12.859a10 10 0 0 1 14 0\"></path><path d=\"M8.5 16.429a5 5 0 0 1 7 0\"></path></svg></div><div class=\"flex items-start justify-between gap-5\"><div><p class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-orange-600\">Step <!-- -->03</p><h3 class=\"mt-2 text-xl font-semibold tracking-tight text-slate-950\">Signal normalized</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">The adapter translates the event into one consistent operational record.</p></div><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-1 hidden h-5 w-5 shrink-0 text-slate-300 transition group-hover:text-orange-500 sm:block\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg></div></article><article class=\"group relative rounded-[1.6rem] border border-slate-200 bg-white p-5 pl-[5rem] shadow-sm transition duration-500 hover:-translate-y-0.5 hover:border-orange-200 hover:shadow-[0_24px_65px_rgba(249,115,22,0.1)] sm:p-7 sm:pl-[6.5rem]\" style=\"opacity:0.35;transform:translateX(22px)\"><div class=\"absolute left-3.5 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-2xl border border-orange-200 bg-orange-50 text-orange-600 shadow-[0_0_0_8px_white] transition group-hover:bg-orange-600 group-hover:text-white sm:left-5 sm:h-12 sm:w-12\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-gauge h-5 w-5\" aria-hidden=\"true\"><path d=\"m12 14 4-4\"></path><path d=\"M3.34 19a10 10 0 1 1 17.32 0\"></path></svg></div><div class=\"flex items-start justify-between gap-5\"><div><p class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-orange-600\">Step <!-- -->04</p><h3 class=\"mt-2 text-xl font-semibold tracking-tight text-slate-950\">Confidence checked</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Freshness, receiver health, and signal quality are evaluated before display.</p></div><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-1 hidden h-5 w-5 shrink-0 text-slate-300 transition group-hover:text-orange-500 sm:block\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg></div></article><article class=\"group relative rounded-[1.6rem] border border-slate-200 bg-white p-5 pl-[5rem] shadow-sm transition duration-500 hover:-translate-y-0.5 hover:border-orange-200 hover:shadow-[0_24px_65px_rgba(249,115,22,0.1)] sm:p-7 sm:pl-[6.5rem]\" style=\"opacity:0.35;transform:translateX(22px)\"><div class=\"absolute left-3.5 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-2xl border border-orange-200 bg-orange-50 text-orange-600 shadow-[0_0_0_8px_white] transition group-hover:bg-orange-600 group-hover:text-white sm:left-5 sm:h-12 sm:w-12\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-route h-5 w-5\" aria-hidden=\"true\"><circle cx=\"6\" cy=\"19\" r=\"3\"></circle><path d=\"M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15\"></path><circle cx=\"18\" cy=\"5\" r=\"3\"></circle></svg></div><div class=\"flex items-start justify-between gap-5\"><div><p class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-orange-600\">Step <!-- -->05</p><h3 class=\"mt-2 text-xl font-semibold tracking-tight text-slate-950\">Pass context compared</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Expected route and timing are compared with the active pass state.</p></div><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-1 hidden h-5 w-5 shrink-0 text-slate-300 transition group-hover:text-orange-500 sm:block\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg></div></article><article class=\"group relative rounded-[1.6rem] border border-slate-200 bg-white p-5 pl-[5rem] shadow-sm transition duration-500 hover:-translate-y-0.5 hover:border-orange-200 hover:shadow-[0_24px_65px_rgba(249,115,22,0.1)] sm:p-7 sm:pl-[6.5rem]\" style=\"opacity:0.35;transform:translateX(22px)\"><div class=\"absolute left-3.5 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-2xl border border-orange-200 bg-orange-50 text-orange-600 shadow-[0_0_0_8px_white] transition group-hover:bg-orange-600 group-hover:text-white sm:left-5 sm:h-12 sm:w-12\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-triangle-alert h-5 w-5\" aria-hidden=\"true\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"></path><path d=\"M12 9v4\"></path><path d=\"M12 17h.01\"></path></svg></div><div class=\"flex items-start justify-between gap-5\"><div><p class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-orange-600\">Step <!-- -->06</p><h3 class=\"mt-2 text-xl font-semibold tracking-tight text-slate-950\">Incident opened</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">A reviewable exception is created with the relevant context attached.</p></div><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-1 hidden h-5 w-5 shrink-0 text-slate-300 transition group-hover:text-orange-500 sm:block\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg></div></article><article class=\"group relative rounded-[1.6rem] border border-slate-200 bg-white p-5 pl-[5rem] shadow-sm transition duration-500 hover:-translate-y-0.5 hover:border-orange-200 hover:shadow-[0_24px_65px_rgba(249,115,22,0.1)] sm:p-7 sm:pl-[6.5rem]\" style=\"opacity:0.35;transform:translateX(22px)\"><div class=\"absolute left-3.5 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-2xl border border-orange-200 bg-orange-50 text-orange-600 shadow-[0_0_0_8px_white] transition group-hover:bg-orange-600 group-hover:text-white sm:left-5 sm:h-12 sm:w-12\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-user-check h-5 w-5\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><polyline points=\"16 11 18 13 22 9\"></polyline></svg></div><div class=\"flex items-start justify-between gap-5\"><div><p class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-orange-600\">Step <!-- -->07</p><h3 class=\"mt-2 text-xl font-semibold tracking-tight text-slate-950\">Staff response assigned</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Authorized staff acknowledge, assign, respond, and document the outcome.</p></div><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-1 hidden h-5 w-5 shrink-0 text-slate-300 transition group-hover:text-orange-500 sm:block\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg></div></article><article class=\"group relative rounded-[1.6rem] border border-slate-200 bg-white p-5 pl-[5rem] shadow-sm transition duration-500 hover:-translate-y-0.5 hover:border-orange-200 hover:shadow-[0_24px_65px_rgba(249,115,22,0.1)] sm:p-7 sm:pl-[6.5rem]\" style=\"opacity:0.35;transform:translateX(22px)\"><div class=\"absolute left-3.5 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-2xl border border-orange-200 bg-orange-50 text-orange-600 shadow-[0_0_0_8px_white] transition group-hover:bg-orange-600 group-hover:text-white sm:left-5 sm:h-12 sm:w-12\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-check2 h-5 w-5\" aria-hidden=\"true\"><path d=\"M4 22h14a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v4\"></path><path d=\"M14 2v4a2 2 0 0 0 2 2h4\"></path><path d=\"m3 15 2 2 4-4\"></path></svg></div><div class=\"flex items-start justify-between gap-5\"><div><p class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-orange-600\">Step <!-- -->08</p><h3 class=\"mt-2 text-xl font-semibold tracking-tight text-slate-950\">Pilot proof recorded</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Reliability, response, and usefulness roll into the pilot evidence report.</p></div><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-1 hidden h-5 w-5 shrink-0 text-slate-300 transition group-hover:text-orange-500 sm:block\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg></div></article></div></div></div></section><section class=\"dark-grid relative isolate overflow-hidden bg-[#060b14] px-5 py-24 sm:px-6 lg:px-8 lg:py-36\"><div class=\"pointer-events-none absolute left-1/2 top-1/3 h-[36rem] w-[58rem] -translate-x-1/2 rounded-full bg-orange-600/15 blur-[150px]\"></div><div class=\"relative mx-auto max-w-7xl\"><div class=\"mx-auto max-w-3xl text-center\" style=\"opacity:0;transform:translateY(22px)\"><p class=\"text-xs font-bold uppercase tracking-[0.24em] text-orange-300\">Command center</p><h2 class=\"mt-4 text-balance text-4xl font-semibold tracking-[-0.045em] sm:text-5xl lg:text-6xl text-white\">One calm view of what needs attention.</h2><p class=\"mt-5 text-balance text-base leading-8 sm:text-lg text-slate-300\">Orange marks active work. Red is reserved for true critical events. Everything else stays quiet.</p></div><div class=\"mt-14 grid gap-3 sm:grid-cols-3\"><div class=\"rounded-2xl border border-white/10 bg-white/[0.055] p-4 backdrop-blur-xl\" style=\"opacity:0;transform:translateY(16px)\"><p class=\"text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500\">Active incidents</p><p class=\"mt-2 flex items-center gap-2 text-sm font-semibold text-white\"><span class=\"relative flex h-2.5 w-2.5\" aria-hidden=\"true\"><span class=\"absolute inline-flex h-full w-full animate-ping rounded-full opacity-25 bg-orange-500 shadow-orange-500/50\"></span><span class=\"relative inline-flex h-2.5 w-2.5 rounded-full shadow-[0_0_14px_currentColor] bg-orange-500 shadow-orange-500/50\"></span></span>2 open</p></div><div class=\"rounded-2xl border border-white/10 bg-white/[0.055] p-4 backdrop-blur-xl\" style=\"opacity:0;transform:translateY(16px)\"><p class=\"text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500\">Receiver health</p><p class=\"mt-2 flex items-center gap-2 text-sm font-semibold text-white\"><span class=\"relative flex h-2.5 w-2.5\" aria-hidden=\"true\"><span class=\"absolute inline-flex h-full w-full animate-ping rounded-full opacity-25 bg-emerald-400 shadow-emerald-400/50\"></span><span class=\"relative inline-flex h-2.5 w-2.5 rounded-full shadow-[0_0_14px_currentColor] bg-emerald-400 shadow-emerald-400/50\"></span></span>41 online</p></div><div class=\"rounded-2xl border border-white/10 bg-white/[0.055] p-4 backdrop-blur-xl\" styl