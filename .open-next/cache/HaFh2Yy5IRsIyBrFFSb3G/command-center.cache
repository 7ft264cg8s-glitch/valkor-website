shadow-lg hover:shadow-orange-600/20\" href=\"/#request-pilot\">Limited Pilot Review</a></div><button type=\"button\" class=\"inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-white/90 text-slate-800 shadow-sm shadow-slate-200/70 backdrop-blur focus:outline-none focus:ring-2 focus:ring-cyan-500/70 focus:ring-offset-2 lg:hidden\" aria-label=\"Toggle navigation\" aria-expanded=\"false\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu h-5 w-5\"><line x1=\"4\" x2=\"20\" y1=\"12\" y2=\"12\"></line><line x1=\"4\" x2=\"20\" y1=\"6\" y2=\"6\"></line><line x1=\"4\" x2=\"20\" y1=\"18\" y2=\"18\"></line></svg></button></nav></header><div aria-hidden=\"true\" class=\"h-[4.5rem]\"></div><main><section class=\"relative isolate overflow-hidden border-b border-slate-200 bg-white px-5 py-16 sm:px-6 lg:px-8 lg:py-20\"><div class=\"pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_20%_8%,rgba(249,115,22,0.11),transparent_30%),linear-gradient(180deg,rgba(255,255,255,0.88)_0%,#ffffff_75%)]\"></div><div class=\"relative z-10 mx-auto max-w-4xl\"><p class=\"text-sm font-bold uppercase tracking-[0.22em] text-orange-700\">Command Center</p><h1 class=\"mt-4 text-4xl font-semibold tracking-[-0.04em] text-slate-950 sm:text-6xl\">A calm operations console for school staff.</h1><p class=\"mt-5 max-w-3xl text-lg leading-8 text-slate-600\">The dashboard helps an assistant principal understand building state quickly through zones, exceptions, confidence, device health, and accountable workflow status.</p><div class=\"mt-8 flex flex-col gap-3 sm:flex-row\"><a class=\"inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition duration-300 focus:outline-none focus:ring-2 focus:ring-orange-500/70 focus:ring-offset-2 focus:ring-white border border-orange-500/20 bg-orange-600 text-white shadow-lg shadow-orange-600/20 hover:bg-orange-700 hover:shadow-xl hover:shadow-orange-600/25 active:translate-y-px \" href=\"/#request-pilot\">Request Pilot Review<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a class=\"inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition duration-300 focus:outline-none focus:ring-2 focus:ring-orange-500/70 focus:ring-offset-2 focus:ring-white border border-slate-200/80 bg-white/[0.88] text-slate-900 shadow-sm shadow-slate-200/60 backdrop-blur hover:border-slate-300 hover:bg-white hover:shadow-md active:translate-y-px \" href=\"mailto:jackson@valkorsystems.com?subject=Valkor%20Pilot%20Review%20Request\">Email Valkor</a></div></div></section><div class=\"bg-[linear-gradient(180deg,#f8fafc_0%,#ffffff_100%)] px-5 py-16 sm:px-6 lg:px-8\"><div class=\"mx-auto grid max-w-7xl gap-8\"><section class=\"rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60 sm:p-8\"><h2 class=\"mt-2 text-3xl font-semibold tracking-[-0.03em] text-slate-950\">Top command bar</h2><div class=\"mt-5 grid gap-3 sm:grid-cols-2\"><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>School Mode</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Attendance State</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Active Incidents</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Top Priority</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>System Confidence</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>RTLS Feed Health</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Anchor Health</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Tag / Badge Health</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Next Schedule Transition</span></div></div></section><section class=\"rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60 sm:p-8\"><h2 class=\"mt-2 text-3xl font-semibold tracking-[-0.03em] text-slate-950\">Command focus panel</h2><p class=\"mt-4 max-w-4xl text-base leading-8 text-slate-600\">Example: Elevated route deviation. Student 018 appears outside approved bathroom route. Believed Zone: Cafeteria Hall. Freshness: Last seen 3s ago. Confidence: High. Suggested Action: Assign nearest available staff.</p><p class=\"mt-6 rounded-2xl border border-orange-200 bg-orange-50 p-5 text-sm font-semibold leading-6 text-slate-800\">The default map should prioritize zone status, exceptions, confidence, and workflows.</p></section><section class=\"rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60 sm:p-8\"><h2 class=\"mt-2 text-3xl font-semibold tracking-[-0.03em] text-slate-950\">Zone map default</h2><p class=\"mt-4 max-w-4xl text-base leading-8 text-slate-600\">The default map shows zone status, not every student dot. Example zone card: Bathroom A Entrance. Occupancy: 4. Passes Active: 2. Overdue: 1. Anchor Health: Healthy. Confidence: 88%.</p></section><section class=\"rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60 sm:p-8\"><h2 class=\"mt-2 text-3xl font-semibold tracking-[-0.03em] text-slate-950\">Incident lifecycle</h2><div class=\"mt-5 grid gap-3 sm:grid-cols-2\"><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Detected</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Validating</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Open</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Acknowledged</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Assigned</span></div><div class=\"flex gap-3 rounded-2