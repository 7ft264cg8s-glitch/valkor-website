{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/privacy/layout,_N_T_/privacy/page,_N_T_/privacy"}},"html":"<!DOCTYPE html><!--HaFh2Yy5IRsIyBrFFSb3G--><html lang=\"en\" class=\"scroll-smooth\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/e4af272ccee01ff0-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Fvalkor-logo.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fvalkor-logo.png&amp;w=384&amp;q=75 2x\"/><link rel=\"stylesheet\" href=\"/_next/static/css/7bc07c4560c01387.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-72c1bf8cb8877324.js\"/><script src=\"/_next/static/chunks/4bd1b696-c023c6e3521b1417.js\" async=\"\"></script><script src=\"/_next/static/chunks/255-62902f04efbdd792.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-1b8fa55561577cec.js\" async=\"\"></script><script src=\"/_next/static/chunks/724-cf65792c48e33df3.js\" async=\"\"></script><script src=\"/_next/static/chunks/725-102a69bb248c73da.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/privacy/page-e4b4c03c0a1c54b5.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>Valkor Systems | School-controlled operational awareness.</title><meta name=\"description\" content=\"Review movement exceptions, pass activity, receiver health, and incident follow-up from one calm school-hours command center.\"/><meta property=\"og:title\" content=\"Valkor Systems | School-controlled operational awareness.\"/><meta property=\"og:description\" content=\"Review movement exceptions, pass activity, receiver health, and incident follow-up from one calm school-hours command center.\"/><meta property=\"og:url\" content=\"https://www.valkorsystems.com\"/><meta property=\"og:site_name\" content=\"Valkor Systems\"/><meta property=\"og:image\" content=\"https://www.valkorsystems.com/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Valkor Systems school-controlled operational awareness command center.\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Valkor Systems | School-controlled operational awareness.\"/><meta name=\"twitter:description\" content=\"Review movement exceptions, pass activity, receiver health, and incident follow-up from one calm school-hours command center.\"/><meta name=\"twitter:image\" content=\"https://www.valkorsystems.com/og.png\"/><link rel=\"shortcut icon\" href=\"/favicon.ico\"/><link rel=\"icon\" href=\"/favicon.ico\"/><link rel=\"icon\" href=\"/icon.png\" type=\"image/png\"/><link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"__variable_f367f3 bg-valkor-bg font-sans text-valkor-text antialiased\"><div hidden=\"\"><!--$--><!--/$--></div><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"Valkor Systems\",\"url\":\"https://www.valkorsystems.com\",\"logo\":\"https://www.valkorsystems.com/valkor-logo.png\",\"email\":\"jackson@valkorsystems.com\"}</script><header class=\"fixed inset-x-0 top-0 z-[100] border-b border-slate-200/70 bg-white/95 shadow-sm shadow-slate-200/40 backdrop-blur-2xl\"><nav class=\"mx-auto flex h-[4.5rem] max-w-7xl items-center justify-between px-5 sm:px-6 lg:px-8\"><a class=\"flex items-center gap-3\" aria-label=\"Valkor Systems home\" href=\"/\"><img alt=\"Valkor Systems\" width=\"156\" height=\"45\" decoding=\"async\" data-nimg=\"1\" class=\"h-8 w-auto object-contain contrast-125 saturate-110 brightness-95\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fvalkor-logo.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fvalkor-logo.png&amp;w=384&amp;q=75 2x\" src=\"/_next/image?url=%2Fvalkor-logo.png&amp;w=384&amp;q=75\"/></a><div class=\"hidden items-center gap-6 lg:flex\"><a class=\"rounded-full px-1 py-2 text-sm font-semibold text-slate-600 transition duration-200 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-cyan-500/70 focus:ring-offset-4\" href=\"/#what-valkor-does\">Product</a><a class=\"rounded-full px-1 py-2 text-sm font-semibold text-slate-600 transition duration-200 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-cyan-500/70 focus:ring-offset-4\" href=\"/pilot\">Pilot Program</a><a class=\"rounded-full px-1 py-2 text-sm font-semibold text-slate-600 transition duration-200 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-cyan-500/70 focus:ring-offset-4\" href=\"/trust-center\">Trust &amp; Privacy</a><a class=\"rounded-full px-1 py-2 text-sm font-semibold text-slate-600 transition duration-200 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-cyan-500/70 focus:ring-offset-4\" href=\"/it-security\">Technical Overview</a><a class=\"rounded-full px-1 py-2 text-sm font-semibold text-slate-600 transition duration-200 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-cyan-500/70 focus:ring-offset-4\" href=\"/#request-pilot\">Request Pilot</a></div><div class=\"hidden lg:block\"><a class=\"inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition duration-300 focus:outline-none focus:ring-2 focus:ring-orange-500/70 focus:ring-offset-2 focus:ring-white border border-orange-500/20 bg-orange-600 text-white shadow-lg shadow-orange-600/20 hover:bg-orange-700 hover:shadow-xl hover:shadow-orange-600/25 active:translate-y-px px-4 py-2.5 text-[13px] shadow-md shadow-orange-600/15 hover:shadow-lg hover:shadow-orange-600/20\" href=\"/#request-pilot\">Limited Pilot Review</a></div><button type=\"button\" class=\"inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-white/90 text-slate-800 shadow-sm shadow-slate-200/70 backdrop-blur focus:outline-none focus:ring-2 focus:ring-cyan-500/70 focus:ring-offset-2 lg:hidden\" aria-label=\"Toggle navigation\" aria-expanded=\"false\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu h-5 w-5\"><line x1=\"4\" x2=\"20\" y1=\"12\" y2=\"12\"></line><line x1=\"4\" x2=\"20\" y1=\"6\" y2=\"6\"></line><line x1=\"4\" x2=\"20\" y1=\"18\" y2=\"18\"></line></svg></button></nav></header><div aria-hidden=\"true\" class=\"h-[4.5rem]\"></div><main><section class=\"relative isolate overflow-hidden border-b border-slate-200 bg-white px-5 py-16 sm:px-6 lg:px-8 lg:py-20\"><div class=\"pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_20%_8%,rgba(249,115,22,0.11),transparent_30%),linear-gradient(180deg,rgba(255,255,255,0.88)_0%,#ffffff_75%)]\"></div><div class=\"relative z-10 mx-auto max-w-4xl\"><p class=\"text-sm font-bold uppercase tracking-[0.22em] text-orange-700\">Trust Center</p><h1 class=\"mt-4 text-4xl font-semibold tracking-[-0.04em] text-slate-950 sm:text-6xl\">Privacy, governance, and school-control boundaries.</h1><p class=\"mt-5 max-w-3xl text-lg leading-8 text-slate-600\">Valkor collects operationally justified data, explains why it exists, restricts access, logs sensitive actions, supports school-controlled retention, and avoids unrelated uses like advertising, consumer tracking, or automatic discipline.</p><div class=\"mt-8 flex flex-col gap-3 sm:flex-row\"><a class=\"inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition duration-300 focus:outline-none focus:ring-2 focus:ring-orange-500/70 focus:ring-offset-2 focus:ring-white border border-orange-500/20 bg-orange-600 text-white shadow-lg shadow-orange-600/20 hover:bg-orange-700 hover:shadow-xl hover:shadow-orange-600/25 active:translate-y-px \" href=\"/#request-pilot\">Request Pilot Review<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a class=\"inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition duration-300 focus:outline-none focus:ring-2 focus:ring-orange-500/70 focus:ring-offset-2 focus:ring-white border border-slate-200/80 bg-white/[0.88] text-slate-900 shadow-sm shadow-slate-200/60 backdrop-blur hover:border-slate-300 hover:bg-white hover:shadow-md active:translate-y-px \" href=\"mailto:jackson@valkorsystems.com?subject=Valkor%20Pilot%20Review%20Request\">Email Valkor</a></div></div></section><div class=\"bg-[linear-gradient(180deg,#f8fafc_0%,#ffffff_100%)] px-5 py-16 sm:px-6 lg:px-8\"><div class=\"mx-auto grid max-w-7xl gap-8\"><section class=\"rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60 sm:p-8\"><h2 class=\"mt-2 text-3xl font-semibold tracking-[-0.03em] text-slate-950\">What Valkor collects and why</h2><p class=\"mt-4 max-w-4xl text-base leading-8 text-slate-600\">Depending on deployment scope, Valkor may process badge identifiers, zone-level movement events, timestamps, confidence/freshness status, pass status, device health, incident workflow records, admin actions, audit logs, diagnostics, and pilot metrics.</p><div class=\"mt-5 grid gap-3 sm:grid-cols-2\"><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Approved school operational awareness</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Attendance and accountability review</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Device-health and reliability monitoring</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Incident documentation and staff response</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Pilot evaluation and system improvement</span></div></div></section><section class=\"rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60 sm:p-8\"><h2 class=\"mt-2 text-3xl font-semibold tracking-[-0.03em] text-slate-950\">School-controlled deployment</h2><div class=\"mt-5 grid gap-3 sm:grid-cols-2\"><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Included zones</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Approved badges</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Authorized users</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Retention rules</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Approved use cases</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Parent communication</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Pilot approval and expansion decisions</span></div></div></section><section class=\"rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60 sm:p-8\"><h2 class=\"mt-2 text-3xl font-semibold tracking-[-0.03em] text-slate-950\">Access, audit logs, and retention</h2><div class=\"mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3\"><article class=\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\"><div class=\"flex items-start justify-between gap-4\"><h3 class=\"text-lg font-semibold text-slate-950\">Role-Based Access</h3></div><p class=\"mt-3 text-sm leading-6 text-slate-600\">Not every user sees every student, every movement event, or every diagnostic record.</p></article><article class=\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\"><div class=\"flex items-start justify-between gap-4\"><h3 class=\"text-lg font-semibold text-slate-950\">Audit Logs</h3></div><p class=\"mt-3 text-sm leading-6 text-slate-600\">Sensitive actions such as viewing restricted records, changing badge assignments, exporting data, acknowledging incidents, dismissing incidents, and resolving alerts should be logged.</p></article><article class=\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\"><div class=\"flex items-start justify-between gap-4\"><h3 class=\"text-lg font-semibold text-slate-950\">Retention &amp; Deletion</h3></div><p class=\"mt-3 text-sm leading-6 text-slate-600\">Schools define how long live events, incident records, audit logs, historical tracks, diagnostics, and pilot metrics are retained.</p></article></div></section><section class=\"rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60 sm:p-8\"><h2 class=\"mt-2 text-3xl font-semibold tracking-[-0.03em] text-slate-950\">Clear product boundaries</h2><div class=\"mt-5 grid gap-3 sm:grid-cols-2\"><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>No GPS</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>No home tracking</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>No microphones</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>No cameras</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>No facial recognition</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>No biometrics</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>No student phone monitoring</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>No automatic discipline</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Does not replace emergency procedures or trained staff judgment</span></div></div><p class=\"mt-6 rounded-2xl border border-orange-200 bg-orange-50 p-5 text-sm font-semibold leading-6 text-slate-800\">Valkor supports human-reviewed workflows. School personnel verify facts and decide what action is appropriate.</p></section><section class=\"rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60 sm:p-8\"><h2 class=\"mt-2 text-3xl font-semibold tracking-[-0.03em] text-slate-950\">Signal infrastructure boundary</h2><p class=\"mt-4 max-w-4xl text-base leading-8 text-slate-600\">Valkor may integrate with approved RTLS infrastructure providers, such as Blueiot/LocalSense, to receive building-local location, badge, zone, device-health, attendance, roll call, historical track, and alarm signals. The infrastructure provider supplies the physical positioning layer; Valkor provides the school-facing command, workflow, privacy, and reporting layer.</p></section><section class=\"rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60 sm:p-8\"><h2 class=\"mt-2 text-3xl font-semibold tracking-[-0.03em] text-slate-950\">Parent-facing explanation</h2><p class=\"mt-4 max-w-4xl text-base leading-8 text-slate-600\">Valkor is designed around approved school operations, zone-level presence, authorized staff access, school-controlled retention, and human-reviewed workflows. It does not require GPS, phone tracking, cameras, microphones, biometrics, or automatic discipline.</p></section><section class=\"rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60 sm:p-8\"><h2 class=\"mt-2 text-3xl font-semibold tracking-[-0.03em] text-slate-950\">IT/security review questions</h2><div class=\"mt-5 grid gap-3 sm:grid-cols-2\"><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Which zones are included in the pilot?</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Which badges are approved and who manages assignment?</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Which users can see live status, history, diagnostics, exports, and audit logs?</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>How long are live events, incidents, diagnostics, historical tracks, audit logs, and pilot metrics retained?</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>How are stale data, offline anchors, low-battery tags, feed delays, and parser failures displayed?</span></div><div class=\"flex gap-3 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-valkor-orange\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>What data can be exported or deleted at school request?</span></div></div></section><section class=\"rounded-[2rem] bg-slate-950 p-6 text-white shadow-2xl shadow-slate-300/60 sm:p-8\"><div class=\"grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center\"><div><h2 class=\"text-3xl font-semibold tracking-[-0.03em]\">Request a limited pilot review.</h2><p class=\"mt-3 max-w-3xl text-sm leading-6 text-slate-300\">Pilot reviews cover operational pain points, privacy and governance boundaries, infrastructure readiness, pilot scope, reliability expectations, success metrics, and end-of-pilot reporting.</p></div><div class=\"flex flex-col gap-3 sm:flex-row lg:justify-end\"><a class=\"inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition duration-300 focus:outline-none focus:ring-2 focus:ring-orange-500/70 focus:ring-offset-2 focus:ring-white border border-orange-500/20 bg-orange-600 text-white shadow-lg shadow-orange-600/20 hover:bg-orange-700 hover:shadow-xl hover:shadow-orange-600/25 active:translate-y-px \" href=\"/#request-pilot\">Request Pilot Review<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a class=\"inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition duration-300 focus:outline-none focus:ring-2 focus:ring-orange-500/70 focus:ring-offset-2 focus:ring-white border border-white/15 bg-white/[0.08] text-white shadow-sm shadow-black/20 backdrop-blur hover:border-white/25 hover:bg-white/[0.14] active:translate-y-px \" href=\"mailto:jackson@valkorsystems.com?subject=Valkor%20Limited%20Pilot%20Review%20Request\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-mail h-4 w-4\" aria-hidden=\"true\"><rect width=\"20\" height=\"16\" x=\"2\" y=\"4\" rx=\"2\"></rect><path d=\"m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7\"></path></svg>Email</a></div></div></section></div></div></main><footer class=\"border-t border-slate-200/80 bg-[linear-gradient(180deg,#ffffff_0%,#f8fafc_100%)] px-5 py-12 sm:px-6 lg:px-8\"><div class=\"mx-auto flex max-w-7xl flex-col gap-8 lg:flex-row lg:items-start lg:justify-between\"><div><img alt=\"Valkor Systems\" loading=\"lazy\" width=\"170\" height=\"49\" decoding=\"async\" data-nimg=\"1\" class=\"h-9 w-auto object-contain\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fvalkor-logo.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fvalkor-logo.png&amp;w=384&amp;q=75 2x\" src=\"/_next/image?url=%2Fvalkor-logo.png&amp;w=384&amp;q=75\"/><p class=\"mt-4 max-w-md text-sm leading-6 text-slate-600\">School-controlled operational awareness for pass accountability, attendance reconciliation, incident workflow, staff response, confidence, and audit records.</p><p class=\"mt-2 max-w-md text-sm font-semibold leading-6 text-slate-700\">Currently accepting pilot applications - Virginia and East Coast schools.</p><p class=\"mt-3 text-sm text-slate-600\">Contact:<!-- --> <a class=\"font-medium text-slate-950 transition hover:text-valkor-orange\" href=\"mailto:jackson@valkorsystems.com\">jackson@valkorsystems.com</a></p></div><div class=\"flex flex-wrap gap-x-6 gap-y-3 lg:justify-end\"><a class=\"text-sm font-medium text-slate-600 transition hover:text-slate-950\" href=\"/pilot\">Pilot Program</a><a class=\"text-sm font-medium text-slate-600 transition hover:text-slate-950\" href=\"/trust-center\">Trust Center</a><a class=\"text-sm font-medium text-slate-600 transition hover:text-slate-950\" href=\"/it-security\">IT &amp; Security</a><a class=\"text-sm font-medium text-slate-600 transition hover:text-slate-950\" href=\"/resources\">Resources</a></div></div><div class=\"mx-auto mt-8 max-w-7xl border-t border-slate-200/80 pt-6 text-sm text-slate-500\">© <!-- -->2026<!-- --> Valkor Systems. 