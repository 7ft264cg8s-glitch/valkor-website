turate-110 brightness-95\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fvalkor-logo.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fvalkor-logo.png&amp;w=384&amp;q=75 2x\" src=\"/_next/image?url=%2Fvalkor-logo.png&amp;w=384&amp;q=75\"/></a><div class=\"hidden items-center gap-6 lg:flex\"><a class=\"rounded-full px-1 py-2 text-sm font-semibold text-slate-600 transition duration-200 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-cyan-500/70 focus:ring-offset-4\" href=\"/#what-valkor-does\">Product</a><a class=\"rounded-full px-1 py-2 text-sm font-semibold text-slate-600 transition duration-200 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-cyan-500/70 focus:ring-offset-4\" href=\"/pilot\">Pilot Program</a><a class=\"rounded-full px-1 py-2 text-sm font-semibold text-slate-600 transition duration-200 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-cyan-500/70 focus:ring-offset-4\" href=\"/trust-center\">Trust &amp; Privacy</a><a class=\"rounded-full px-1 py-2 text-sm font-semibold text-slate-600 transition duration-200 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-cyan-500/70 focus:ring-offset-4\" href=\"/it-security\">Technical Overview</a><a class=\"rounded-full px-1 py-2 text-sm font-semibold text-slate-600 transition duration-200 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-cyan-500/70 focus:ring-offset-4\" href=\"/#request-pilot\">Request Pilot</a></div><div class=\"hidden lg:block\"><a class=\"inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition duration-300 focus:outline-none focus:ring-2 focus:ring-orange-500/70 focus:ring-offset-2 focus:ring-white border border-orange-500/20 bg-orange-600 text-white shadow-lg shadow-orange-600/20 hover:bg-orange-700 hover:shadow-xl hover:shadow-orange-600/25 active:translate-y-px px-4 py-2.5 text-[13px] shadow-md shadow-orange-600/15 hover:shadow-lg hover:shadow-orange-600/20\" href=\"/#request-pilot\">Limited Pilot Review</a></div><button type=\"button\" class=\"inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-white/90 text-slate-800 shadow-sm shadow-slate-200/70 backdrop-blur focus:outline-none focus:ring-2 focus:ring-cyan-500/70 focus:ring-offset-2 lg:hidden\" aria-label=\"Toggle navigation\" aria-expanded=\"false\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu h-5 w-5\"><line x1=\"4\" x2=\"20\" y1=\"12\" y2=\"12\"></line><line x1=\"4\" x2=\"20\" y1=\"6\" y2=\"6\"></line><line x1=\"4\" x2=\"20\" y1=\"18\" y2=\"18\"></line></svg></button></nav></header><div aria-hidden=\"true\" class=\"h-[4.5rem]\"></div><main><section class=\"relative isolate overflow-hidden border-b border-slate-200 bg-white px-5 py-16 sm:px-6 lg:px-8 lg:py-20\"><div class=\"pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_20%_8%,rgba(249,115,22,0.11),transparent_30%),linear-gradient(180deg,rgba(255,255,255,0.88)_0%,#ffffff_75%)]\"></div><div class=\"relative z-10 mx-auto max-w-4xl\"><p class=\"text-sm font-bold uppercase tracking-[0.22em] text-orange-700\">FAQ</p><h1 class=\"mt-4 text-4xl font-semibold tracking-[-0.04em] text-slate-950 sm:text-6xl\">Frequently asked questions.</h1><p class=\"mt-5 max-w-3xl text-lg leading-8 text-slate-600\">Answers for school leaders, IT reviewers, privacy reviewers, parents, and advisors considering a controlled Valkor pilot.</p><div class=\"mt-8 flex flex-col gap-3 sm:flex-row\"><a class=\"inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition duration-300 focus:outline-none focus:ring-2 focus:ring-orange-500/70 focus:ring-offset-2 focus:ring-white border border-orange-500/20 bg-orange-600 text-white shadow-lg shadow-orange-600/20 hover:bg-orange-700 hover:shadow-xl hover:shadow-orange-600/25 active:translate-y-px \" href=\"/#request-pilot\">Request Pilot Review<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a class=\"inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition duration-300 focus:outline-none focus:ring-2 focus:ring-orange-500/70 focus:ring-offset-2 focus:ring-white border border-slate-200/80 bg-white/[0.88] text-slate-900 shadow-sm shadow-slate-200/60 backdrop-blur hover:border-slate-300 hover:bg-white hover:shadow-md active:translate-y-px \" href=\"mailto:jackson@valkorsystems.com?subject=Valkor%20Pilot%20Review%20Request\">Email Valkor</a></div></div></section><div class=\"bg-[linear-gradient(180deg,#f8fafc_0%,#ffffff_100%)] px-5 py-16 sm:px-6 lg:px-8\"><div class=\"mx-auto grid max-w-7xl gap-8\"><section class=\"rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60 sm:p-8\"><h2 class=\"mt-2 text-3xl font-semibold tracking-[-0.03em] text-slate-950\">Core questions</h2><div class=\"mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3\"><article class=\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\"><div class=\"flex items-start justify-between gap-4\"><h3 class=\"text-lg font-semibold text-slate-950\">What problem does Valkor actually solve?</h3></div><p class=\"mt-3 text-sm leading-6 text-slate-600\">Administrators spend significant time each day without clear context on where students are, whether passes are overdue, whether attendance matches physical presence, and what happened during a hallway incident. Valkor gives approved staff a single reviewable dashboard with zone-level context, confidence levels, and an incident workflow - so they can respond faster and document better.</p></article><article class=\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\"><div class=\"flex items-start justify-between gap-4\"><h3 class=\"text-lg font-semibold text-slate-950\">Who is Valkor built for?</h3></div><p class=\"mt-3 text-sm leading-6 text-slate-600\">Valkor is built for principals, assistant principals, and operations staff who are responsible for daily hallway accountability, pass management, and incident follow-up. It is not a student-facing product and is not accessible to parents or students.</p></article><article class=\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\"><div class=\"flex items-start justify-between gap-4\"><h3 class=\"text-lg font-semibold text-slate-950\">How does Valkor handle location concerns?</h3></div><p class=\"mt-3 text-sm leading-6 text-slate-600\">Valkor is a school-controlled, zone-level operational awareness system for approved campus workflows, authorized users, and human-reviewed decisions.</p></article><article class=\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\"><div class=\"flex items-start justify-between gap-4\"><h3 class=\"text-lg font-semibold text-slate-950\">Does Valkor use GPS?</h3></div><p class=\"mt-3 text-sm leading-6 text-slate-600\">No. Valkor is designed around building-local, school-approved infrastructure for configured campus zones, not GPS tracking.</p></article><article class=\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\"><div class=\"flex items-start justify-between gap-4\"><h3 class=\"text-lg font-semibold text-slate-950\">Can Valkor track students at home?</h3></div><p class=\"mt-3 text-sm leading-6 text-slate-600\">No. Valkor is intended for approved school-controlled use within approved campus zones.</p></article><article class=\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\"><div class=\"flex items-start justify-between gap-4\"><h3 class=\"text-lg font-semibold text-slate-950\">Does Valkor use cameras, microphones, biometrics, or student phones?</h3></div><p class=\"mt-3 text-sm leading-6 text-slate-600\">No. Valkor does not require cameras, microphones, facial recognition, biometrics, student phone monitoring, or a student-facing app.</p></article><article class=\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\"><div class=\"flex items-start justify-between gap-4\"><h3 class=\"text-lg font-semibold text-slate-950\">Does Valkor automatically discipline students?</h3></div><p class=\"mt-3 text-sm leading-6 text-slate-600\">No. Valkor supports human-reviewed workflows. Staff remain responsible for decisions.</p></article><article class=\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\"><div class=\"flex items-start justify-between gap-4\"><h3 class=\"text-lg font-semibold text-slate-950\">What data does Valkor process?</h3></div><p class=\"mt-3 text-sm leading-6 text-slate-600\">Valkor may process badge identifiers, zone-level movement events, timestamps, confidence/freshness status, pass status, device health, incident workflow records, admin actions, audit logs, diagnostics, and pilot metrics.</p></article><article class=\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\"><div class=\"flex items-start justify-between gap-4\"><h3 class=\"text-lg font-semibold text-slate-950\">Who controls deployment?</h3></div><p class=\"mt-3 text-sm leading-6 text-slate-600\">The school controls included zones, approved badges, authorized users, retention settings, parent communication, and pilot approval.</p></article><article class=\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\"><div class=\"flex items-start justify-between gap-4\"><h3 class=\"text-lg font-semibold text-slate-950\">What happens if data is stale or uncertain?</h3></div><p class=\"mt-3 text-sm leading-6 text-slate-600\">Valkor shows freshness and confidence so staff know whether to act, verify, or wait.</p></article><article class=\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\"><div class=\"flex items-start justify-between gap-4\"><h3 class=\"text-lg font-semibold text-slate-950\">What is the difference between Blueiot and Valkor?</h3></div><p class=\"mt-3 text-sm leading-6 text-slate-600\">Blueiot/LocalSense can provide the RTLS infrastructure layer: tags, anchors, positioning, area data, alarms, attendance primitives, and device-health signals. Valkor turns those signals into school workflows, privacy controls, audit logs, command views, and pilot proof.</p></article><article class=\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\"><div class=\"flex items-start justify-between gap-4\"><h3 class=\"text-lg font-semibold text-slate-950\">Does Valkor replace emergency procedures?</h3></div><p class=\"mt-3 text-sm leading-6 text-slate-600\">No. Valkor does not replace school staff, radios, alarms, law enforcement, fire department guidance, emergency plans, or human judgment.</p></article></div></section><section class=\"rounded-[2rem] bg-slate-950 p-6 text-white shadow-2xl shadow-slate-300/60 sm:p-8\"><div class=\"grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center\"><div><h2 class=\"text-3xl font-semibold tracking-[-0.03em]\">Request a limited pilot review.</h2><p class=\"mt-3 max-w-3xl text-sm leading-6 text-slate-300\">Pilot reviews cover operational pain points, privacy and governance boundaries, infrastructure readiness, pilot scope, reliability expectations, success metrics, and end-of-pilot reporting.</p></div><div class=\"flex flex-col gap-3 sm:flex-row lg:justify-end\"><a class=\"inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition duration-300 focus:outline-none focus:ring-2 focus:ring-orange-500/70 focus:ring-offset-2 focus:ring-white border border-orange-500/20 bg-orange-600 text-white shadow-lg shadow-orange-600/20 hover:bg-orange-700 hover:shadow-xl hover:shadow-orange-600/25 active:translate-y-px \" href=\"/#request-pilot\">Request Pilot Review<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a class=\"inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition duration-300 focus:outline-none focus:ring-2 focus:ring-orange-500/70 focus:ring-offset-2 focus:ring-white border border-white/15 bg-white/[0.08] text-white shadow-sm shadow-black/20 backdrop-blur hover:border-white/25 hover:bg-white/[0.14] active:translate-y-px \" href=\"mailto:jackson@valkorsystems.com?subject=Valkor%20Limited%20Pilot%20Review%20Request\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-mail h-4 w-4\" aria-hidden=\"true\"><rect width=\"20\" height=\"16\" x=\"2\" y=\"4\" rx=\"2\"></rect><path d=\"m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7\"></path></svg>Email</a></div></div></section></div></div></main><footer class=\"border-t border-slate-200/80 bg-[linear-gradient(180deg,#ffffff_0%,#f8fafc_100%)] px-5 py-12 sm:px-6 lg:px-8\"><div class=\"mx-auto flex max-w-7xl flex-col gap-8 lg:flex-row lg:items-start lg:justify-between\"><div><img alt=\"Valkor Systems\" loading=\"lazy\" width=\"170\" height=\"49\" decoding=\"async\" data-nimg=\"1\" class=\"h-9 w-auto object-contain\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fvalkor-logo.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fvalkor-logo.png&amp;w=384&amp;q=75 2x\" src=\"/_next/image?url=%2Fvalkor-logo.png&amp;w=384&amp;q=75\"/><p class=\"mt-4 max-w-md text-sm leading-6 text-slate-600\">School-controlled operational awareness for pass accountability, attendance reconciliation, incident workflow, staff response, confidence, and audit records.</p><p class=\"mt-2 max-w-md text-sm font-semibold leading-6 text-slate-700\">Currently accepting pilot applications - Virginia and East Coast schools.</p><p class=\"mt-3 text-sm text-slate-600\">Contact:<!-- --> <a class=\"font-medium text-slate-950 transition hover:text-valkor-orange\" href=\"mailto:jackson@valkorsystems.com\">jackson@valkorsystems.com</a></p></div><div class=\"flex flex-wrap gap-x-6 gap-y-3 lg:justify-end\"><a class=\"text-sm font-medium text-slate-600 transition hover:text-slate-950\" href=\"/pilot\">Pilot Program</a><a class=\"text-sm font-medium text-slate-600 transition hover:text-slate-950\" href=\"/trust-center\">Trust Center</a><a class=\"text-sm font-medium text-slate-600 transition hover:text-slate-950\" href=\"/it-security\">IT &amp; Security</a><a class=\"text-sm font-medium text-slate-600 transition hover:text-slate-950\" href=\"/resources\">Resources</a></div></div><div class=\"mx-auto mt-8 max-w-7xl border-t border-slate-200/80 pt-6 text-sm text-slate-500\">© <!-- -->2026<!-- --> Valkor Systems. All rights reserved.</div></footer><!--$--><!--/$--><script src=\"/_next/static/chunks/webpack-72c1bf8cb8877324.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[9766,[],\\\"\\\"]\\n3:I[8924,[],\\\"\\\"]\\n4:I[1725,[\\\"724\\\",\\\"static/chunks/724-cf65792c48e33df3.js\\\",\\\"725\\\",\\\"static/chunks/725-102a69bb248c73da.js\\\",\\\"505\\\",\\\"static/chunks/app/faq/page-e4b4c03c0a1c54b5.js\\\"],\\\"Header\\\"]\\n5:I[2619,[\\\"724\\\",\\\"static/chunks/724-cf65792c48e33df3.js\\\",\\\"725\\\",\\\"static/chunks/725-102a69bb248c73da.js\\\",\\\"505\\\",\\\"static/chunks/app/faq/page-e4b4c03c0a1c54b5.js\\\"],\\\"\\\"]\\nd:I[7150,[],\\\"\\\"]\\n:HL[\\\"/_next/static/media/e4af272ccee01ff0-s.p.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\