,[],\"AsyncMetadataOutlet\"]\n1c:I[4431,[],\"ViewportBoundary\"]\n1e:I[4431,[],\"MetadataBoundary\"]\n1f:\"$Sreact.suspense\"\n6:[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}]\n7:[\"$\",\"path\",\"xquz4c\",{\"d\":\"m12 5 7 7-7 7\"}]\n8:[\"$\",\"$L5\",null,{\"href\":\"mailto:jackson@valkorsystems.com?subject=Valkor%20Pilot%20Review%20Request\",\"className\":\"inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition duration-300 focus:outline-none focus:ring-2 focus:ring-orange-500/70 focus:ring-offset-2 focus:ring-white border border-slate-200/80 bg-white/[0.88] text-slate-900 shadow-sm shadow-slate-200/60 backdrop-blur hover:border-slate-300 hover:bg-white hover:shadow-md active:translate-y-px \",\"children\":[\"Email Valkor\",null]}]\n9:[\"$\",\"div\",null,{\"className\":\"bg-[linear-gradient(180deg,#f8fafc_0%,#ffffff_100%)] px-5 py-16 sm:px-6 lg:px-8\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto grid max-w-7xl gap-8\",\"children\":[[[\"$\",\"section\",\"Core questions\",{\"className\":\"rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60 sm:p-8\",\"children\":[null,[\"$\",\"h2\",null,{\"className\":\"mt-2 text-3xl font-semibold tracking-[-0.03em] text-slate-950\",\"children\":\"Core questions\"}],null,null,[\"$\",\"div\",null,{\"className\":\"mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3\",\"children\":[[\"$\",\"article\",\"What problem does Valkor actually solve?\",{\"className\":\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-start justify-between gap-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-slate-950\",\"children\":\"What problem does Valkor actually solve?\"}],null]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-slate-600\",\"children\":\"Administrators spend significant time each day without clear context on where students are, whether passes are overdue, whether attendance matches physical presence, and what happened during a hallway incident. Valkor gives approved staff a single reviewable dashboard with zone-level context, confidence levels, and an incident workflow - so they can respond faster and document better.\"}],null]}],[\"$\",\"article\",\"Who is Valkor built for?\",{\"className\":\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-start justify-between gap-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-slate-950\",\"children\":\"Who is Valkor built for?\"}],null]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-slate-600\",\"children\":\"Valkor is built for principals, assistant principals, and operations staff who are responsible for daily hallway accountability, pass management, and incident follow-up. It is not a student-facing product and is not accessible to parents or students.\"}],null]}],[\"$\",\"article\",\"How does Valkor handle location concerns?\",{\"className\":\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-start justify-between gap-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-slate-950\",\"children\":\"How does Valkor handle location concerns?\"}],null]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-slate-600\",\"children\":\"Valkor is a school-controlled, zone-level operational awareness system for approved campus workflows, authorized users, and human-reviewed decisions.\"}],null]}],[\"$\",\"article\",\"Does Valkor use GPS?\",{\"className\":\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-start justify-between gap-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-slate-950\",\"children\":\"Does Valkor use GPS?\"}],null]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-slate-600\",\"children\":\"No. Valkor is designed around building-local, school-approved infrastructure for configured campus zones, not GPS tracking.\"}],null]}],[\"$\",\"article\",\"Can Valkor track students at home?\",{\"className\":\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-start justify-between gap-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-slate-950\",\"children\":\"Can Valkor track students at home?\"}],null]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-slate-600\",\"children\":\"No. Valkor is intended for approved school-controlled use within approved campus zones.\"}],null]}],[\"$\",\"article\",\"Does Valkor use cameras, microphones, biometrics, or student phones?\",{\"className\":\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\",\"children\":[\"$Le\",\"$Lf\",null]}],\"$L10\",\"$L11\",\"$L12\",\"$L13\",\"$L14\",\"$L15\"]}],null]}]],\"$L16\"]}]}]\na:[\"$\",\"footer\",null,{\"className\":\"border-t border-slate-200/80 bg-[linear-gradient(180deg,#ffffff_0%,#f8fafc_100%)] px-5 py-12 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto flex max-w-7xl flex-col gap-8 lg:flex-row lg:items-start lg:justify-between\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"$L17\",null,{\"src\":\"/valkor-logo.png\",\"alt\":\"Valkor Systems\",\"width\":170,\"height\":49,\"className\":\"h-9 w-auto object-contain\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 max-w-md text-sm leading-6 text-slate-600\",\"children\":\"School-controlled operational awareness for pass accountability, attendance reconciliation, incident workflow, staff response, confidence, and audit records.\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 max-w-md text-sm font-semibold leading-6 text-slate-700\",\"children\":\"Currently accepting pilot applications - Virginia and East Coast schools.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm text-slate-600\",\"children\":[\"Contact:\",\" \",[\"$\",\"a\",null,{\"className\":\"font-medium text-slate-950 transition hover:text-valkor-orange\",\"href\":\"mailto:jackson@valkorsystems.com\",\"children\":\"jackson@valkorsystems.com\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-x-6 gap-y-3 lg:justify-end\",\"children\":[[\"$\",\"$L5\",\"/pilot\",{\"href\":\"/pilot\",\"className\":\"text-sm font-medium text-slate-600 transition hover:text-slate-950\",\"children\":\"Pilot Program\"}],[\"$\",\"$L5\",\"/trust-center\",{\"href\":\"/trust-center\",\"className\":\"text-sm font-medium text-slate-600 transition hover:text-slate-950\",\"children\":\"Trust Center\"}],[\"$\",\"$L5\",\"/it-security\",{\"href\":\"/it-security\",\"className\":\"text-sm font-medium text-slate-600 transition hover:text-slate-950\",\"children\":\"IT & Security\"}],[\"$\",\"$L5\",\"/resources\",{\"href\":\"/resources\",\"className\":\"text-sm font-medium text-slate-600 transition hover:text-slate-950\",\"children\":\"Resources\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"mx-auto mt-8 max-w-7xl border-t border-slate-200/80 pt-6 text-sm text-slate-500\",\"children\":[\"© \",2026,\" Valkor Systems. All rights reserved.\"]}]]}]\nb:[\"$\",\"$L18\",null,{\"children\":[\"$L19\",[\"$\",\"$L1a\",null,{\"promise\":\"$@1b\"}]]}]\nc:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L1c\",null,{\"children\":\"$L1d\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L1e\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$1f\",null,{\"fallback\":null,\"children\":\"$L20\"}]}]}]]}]\ne:[\"$\",\"div\",null,{\"className\":\"flex items-start justify-between gap-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-slate-950\",\"children\":\"Does Valkor use cameras, microphones, biometrics, or student phones?\"}],null]}]\nf:[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-slate-600\",\"children\":\"No. Valkor does not require cameras, microphones, facial recognition, biometrics, student phone monitoring, or a student-facing app.\"}]\n10:[\"$\",\"article\",\"Does Valkor automatically discipline students?\",{\"className\":\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-start justify-between gap-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-slate-950\",\"children\":\"Does Valkor automatically discipline students?\"}],null]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-slate-600\",\"children\":\"No. Valkor supports human-reviewed workflows. Staff remain responsible for decisions.\"}],null]}]\n11:[\"$\",\"article\",\"What data does Valkor process?\",{\"className\":\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-start justify-between gap-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-slate-950\",\"children\":\"What data does Valkor process?\"}],null]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-slate-600\",\"children\":\"Valkor may process badge identifiers, zone-level movement events, timestamps, confidence/freshness status, pass status, device health, incident workflow records, admin actions, audit logs, diagnostics, and pilot metrics.\"}],null]}]\n12:[\"$\",\"article\",\"Who controls deployment?\",{\"className\":\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-start justify-between gap-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-slate-950\",\"children\":\"Who controls deployment?\"}],null]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-slate-600\",\"children\":\"The school controls included zones, approved badges, authorized users, retention settings, parent communication, and pilot approval.\"}],null]}]\n13:[\"$\",\"article\",\"What happens if data is stale or uncertain?\",{\"className\":\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-start justify-between gap-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-slate-950\",\"children\":\"What happens if data is stale or uncertain?\"}],null]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-slate-600\",\"children\":\"Valkor shows freshness and confidence so staff know whether to act, verify, or wait.\"}],null]}]\n14:[\"$\",\"article\",\"What is the difference between Blueiot and Valkor?\",{\"className\":\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-start justify-between gap-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-slate-950\",\"children\":\"What is the difference between Blueiot and Valkor?\"}],null]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-slate-600\",\"children\":\"Blueiot/LocalSense can provide the RTLS infrastructure layer: tags, anchors, positioning, area data, alarms, attendance primitives, and device-health signals. Valkor turns those signals into school workflows, privacy controls, audit logs, command views, and pilot proof.\"}],null]}]\n15:[\"$\",\"article\",\"Does Valkor replace emergency procedures?\",{\"className\":\"rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-start justify-between gap-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-slate-950\",\"children\":\"Does Valkor replace emergency procedures?\"}],null]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-slate-600\",\"children\":\"No. Valkor does not replace school staff, radios, alarms, law enforcement, fire department guidance, emergency plans, or human judgment.\"}],null]}]\n16:[\"$\",\"section\",null,{\"className\":\"rounded-[2rem] bg-slate-950 p-6 text-white shadow-2xl shadow-slate-300/60 sm:p-8\",\"children\":[\"$\",\"div\",null,{\"className\":\"grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-3xl font-semibold tracking-[-0.03em]\",\"children\":\"Request a limited pilot review.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 max-w-3xl text-sm leading-6 text-slate-300\",\"children\":\"Pilot reviews cover operational pain points, privacy and governance boundaries, infrastructure readiness, pilot scope, reliability expectations, success metrics, and end-of-pilot reporting.\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-3 sm:flex-row lg:justify-end\",\"children\":[[\"$\",\"$L5\",null,{\"href\":\"/#request-pilot\",\"className\":\"inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition duration-300 focus:outline-none focus:ring-2 focus:ring-orange-500/70 focus:ring-offset-2 focus:ring-white border border-orange-500/20 bg-orange-600 text-white shadow-lg shadow-orange-600/20 hover:bg-orange-700 hover:shadow-xl hover:shadow-orange-600/25 active:translate-y-px \",\"children\":[\"Request Pilot Review\",[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-arrow-right h-4 w-4\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"xquz4c\",{\"d\":\"m12 5 7 7-7 7\"}],\"$undefined\"]}]]}],[\"$\",\"$L5\",null,{\"href\":\"mailto:jackson@valkorsystems.com?subject=Valkor%20Limited%20Pilot%20Review%20Request\",\"classNa