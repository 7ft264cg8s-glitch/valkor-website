{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/future-emergency-readiness/layout,_N_T_/future-emergency-readiness/page,_N_T_/future-emergency-readiness"}},"html":"<!DOCTYPE html><!--HaFh2Yy5IRsIyBrFFSb3G--><html lang=\"en\" class=\"scroll-smooth\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/e4af272ccee01ff0-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Fvalkor-logo.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fvalkor-logo.png&amp;w=384&amp;q=75 2x\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Fbrand%2Fvalkor-floorplan-light.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fbrand%2Fvalkor-floorplan-light.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fbrand%2Fvalkor-floorplan-light.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fbrand%2Fvalkor-floorplan-light.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fbrand%2Fvalkor-floorplan-light.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fbrand%2Fvalkor-floorplan-light.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fbrand%2Fvalkor-floorplan-light.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fbrand%2Fvalkor-floorplan-light.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fbrand%2Fvalkor-floorplan-light.png&amp;w=3840&amp;q=75 3840w\" imageSizes=\"(min-width: 1024px) 52vw, 100vw\"/><link rel=\"stylesheet\" href=\"/_next/static/css/7bc07c4560c01387.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-72c1bf8cb8877324.js\"/><script src=\"/_next/static/chunks/4bd1b696-c023c6e3521b1417.js\" async=\"\"></script><script src=\"/_next/static/chunks/255-62902f04efbdd792.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-1b8fa55561577cec.js\" async=\"\"></script><script src=\"/_next/static/chunks/724-cf65792c48e33df3.js\" async=\"\"></script><script src=\"/_next/static/chunks/725-102a69bb248c73da.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/future-emergency-readiness/page-e4b4c03c0a1c54b5.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>The Future | Valkor Systems</title><meta name=\"description\" content=\"Valkor&#x27;s future emergency-readiness direction: dynamic routing, congestion-aware decision support, drill replay, and clear capability boundaries.\"/><meta property=\"og:title\" content=\"Valkor Systems | School-controlled operational awareness.\"/><meta property=\"og:description\" content=\"Review movement exceptions, pass activity, receiver health, and incident follow-up from one calm school-hours command center.\"/><meta property=\"og:url\" content=\"https://www.valkorsystems.com\"/><meta property=\"og:site_name\" content=\"Valkor Systems\"/><meta property=\"og:image\" content=\"https://www.valkorsystems.com/og.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Valkor Systems school-controlled operational awareness command center.\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Valkor Systems | School-controlled operational awareness.\"/><meta name=\"twitter:description\" content=\"Review movement exceptions, pass activity, receiver health, and incident follow-up from one calm school-hours command center.\"/><meta name=\"twitter:image\" content=\"https://www.valkorsystems.com/og.png\"/><link rel=\"shortcut icon\" href=\"/favicon.ico\"/><link rel=\"icon\" href=\"/favicon.ico\"/><link rel=\"icon\" href=\"/icon.png\" type=\"image/png\"/><link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"__variable_f367f3 bg-valkor-bg font-sans text-valkor-text antialiased\"><div hidden=\"\"><!--$--><!--/$--></div><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"Valkor Systems\",\"url\":\"https://www.valkorsystems.com\",\"logo\":\"https://www.valkorsystems.com/valkor-logo.png\",\"email\":\"jackson@valkorsystems.com\"}</script><header class=\"fixed inset-x-0 top-0 z-[100] border-b border-slate-200/70 bg-white/95 shadow-sm shadow-slate-200/40 backdrop-blur-2xl\"><nav class=\"mx-auto flex h-[4.5rem] max-w-7xl items-center justify-between px-5 sm:px-6 lg:px-8\"><a class=\"flex items-center gap-3\" aria-label=\"Valkor Systems home\" href=\"/\"><img alt=\"Valkor Systems\" width=\"156\" height=\"45\" decoding=\"async\" data-nimg=\"1\" class=\"h-8 w-auto object-contain contrast-125 saturate-110 brightness-95\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fvalkor-logo.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fvalkor-logo.png&amp;w=384&amp;q=75 2x\" src=\"/_next/image?url=%2Fvalkor-logo.png&amp;w=384&amp;q=75\"/></a><div class=\"hidden items-center gap-6 lg:flex\"><a class=\"rounded-full px-1 py-2 text-sm font-semibold text-slate-600 transition duration-200 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-cyan-500/70 focus:ring-offset-4\" href=\"/#what-valkor-does\">Product</a><a class=\"rounded-full px-1 py-2 text-sm font-semibold text-slate-600 transition duration-200 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-cyan-500/70 focus:ring-offset-4\" href=\"/pilot\">Pilot Program</a><a class=\"rounded-full px-1 py-2 text-sm font-semibold text-slate-600 transition duration-200 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-cyan-500/70 focus:ring-offset-4\" href=\"/trust-center\">Trust &amp; Privacy</a><a class=\"rounded-full px-1 py-2 text-sm font-semibold text-slate-600 transition duration-200 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-cyan-500/70 focus:ring-offset-4\" href=\"/it-security\">Technical Overview</a><a class=\"rounded-full px-1 py-2 text-sm font-semibold text-slate-600 transition duration-200 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-cyan-500/70 focus:ring-offset-4\" href=\"/#request-pilot\">Request Pilot</a></div><div class=\"hidden lg:block\"><a class=\"inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition duration-300 focus:outline-none focus:ring-2 focus:ring-orange-500/70 focus:ring-offset-2 focus:ring-white border border-orange-500/20 bg-orange-600 text-white shadow-lg shadow-orange-600/20 hover:bg-orange-700 hover:shadow-xl hover:shadow-orange-600/25 active:translate-y-px px-4 py-2.5 text-[13px] shadow-md shadow-orange-600/15 hover:shadow-lg hover:shadow-orange-600/20\" href=\"/#request-pilot\">Limited Pilot Review</a></div><button type=\"button\" class=\"inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-white/90 text-slate-800 shadow-sm shadow-slate-200/70 backdrop-blur focus:outline-none focus:ring-2 focus:ring-cyan-500/70 focus:ring-offset-2 lg:hidden\" aria-label=\"Toggle navigation\" aria-expanded=\"false\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu h-5 w-5\"><line x1=\"4\" x2=\"20\" y1=\"12\" y2=\"12\"></line><line x1=\"4\" x2=\"20\" y1=\"6\" y2=\"6\"></line><line x1=\"4\" x2=\"20\" y1=\"18\" y2=\"18\"></line></svg></button></nav></header><div aria-hidden=\"true\" class=\"h-[4.5rem]\"></div><main class=\"bg-white text-slate-950\"><section class=\"relative isolate overflow-hidden border-b border-slate-200 bg-white px-5 py-16 sm:px-6 lg:px-8 lg:py-20\"><div class=\"mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center\"><div><p class=\"text-sm font-bold uppercase text-orange-700\">Future Capability Direction</p><h1 class=\"mt-4 text-5xl font-semibold leading-none sm:text-7xl lg:text-8xl\">The Future</h1><p class=\"mt-6 max-w-2xl text-2xl font-semibold leading-9 text-slate-900 sm:text-3xl\">Dynamic routing for the moments static plans cannot predict.</p><p class=\"mt-6 max-w-2xl text-lg leading-8 text-slate-600\">Valkor starts with trusted daily visibility: zone-level awareness, pass movement, receiver health, confidence status, incident workflow, and staff response coordination. That foundation is what makes future emergency intelligence possible without building on guesswork.</p><div class=\"mt-8 flex flex-col gap-3 sm:flex-row\"><a class=\"inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition duration-300 focus:outline-none focus:ring-2 focus:ring-orange-500/70 focus:ring-offset-2 focus:ring-white border border-orange-500/20 bg-orange-600 text-white shadow-lg shadow-orange-600/20 hover:bg-orange-700 hover:shadow-xl hover:shadow-orange-600/25 active:translate-y-px \" href=\"/#request-pilot\">Request Pilot Review<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a class=\"inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition duration-300 focus:outline-none focus:ring-2 focus:ring-orange-500/70 focus:ring-offset-2 focus:ring-white border border-slate-200/80 bg-white/[0.88] text-slate-900 shadow-sm shadow-slate-200/60 backdrop-blur hover:border-slate-300 hover:bg-white hover:shadow-md active:translate-y-px \" href=\"#future-boundary\">View Boundaries</a></div></div><div class=\"relative overflow-hidden rounded-[2rem] border border-slate-200 bg-slate-950 shadow-[0_34px_110px_rgba(15,23,42,0.18)]\"><img alt=\"Conceptual Valkor floorplan with routed signal paths\" width=\"1680\" height=\"945\" decoding=\"async\" data-nimg=\"1\" class=\"aspect-[4/3] w-full object-cover object-center opacity-95\" style=\"color:transparent\" sizes=\"(min-width: 1024px) 52vw, 100vw\" srcSet=\"/_next/image?url=%2Fbrand%2Fvalkor-floorplan-light.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fbrand%2Fvalkor-floorplan-light.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fbrand%2Fvalkor-floorplan-light.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fbrand%2Fvalkor-floorplan-light.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fbrand%2Fvalkor-floorplan-light.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fbrand%2Fvalkor-floorplan-light.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fbrand%2Fvalkor-floorplan-light.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fbrand%2Fvalkor-floorplan-light.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fbrand%2Fvalkor-floorplan-light.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fbrand%2Fvalkor-floorplan-light.png&amp;w=3840&amp;q=75\"/><div class=\"absolute inset-x-4 bottom-4 grid gap-2 sm:grid-cols-2\"><div class=\"rounded-full border border-white/20 bg-slate-950/72 px-3 py-2 text-center text-xs font-semibold text-white backdrop-blur-xl\">Hazard marked</div><div class=\"rounded-full border border-white/20 bg-slate-950/72 px-3 py-2 text-center text-xs font-semibold text-white backdrop-blur-xl\">Exit available</div><div class=\"rounded-full border border-white/20 bg-slate-950/72 px-3 py-2 text-center text-xs font-semibold text-white backdrop-blur-xl\">Confidence likely</div><div class=\"rounded-full border border-white/20 bg-slate-950/72 px-3 py-2 text-center text-xs font-semibold text-white backdrop-blur-xl\">Staff assigned</div></div></div></div></section><section class=\"border-b border-slate-200 bg-[#f5f5f7] px-5 py-16 sm:px-6 lg:px-8 lg:py-24\"><div class=\"mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center\"><div><p class=\"text-sm font-bold uppercase text-cyan-700\">Why It Matters</p><h2 class=\"mt-3 text-4xl font-semibold sm:text-6xl\">Real buildings do not move in perfect plans.</h2></div><div class=\"space-y-5 text-lg leading-8 text-slate-600\"><p>Most school safety systems are built around fixed procedures: lockdown here, evacuate there, follow the posted route. Those procedures matter. Worst-case events rarely unfold inside clean assumptions.</p><p>Students are not always in classrooms. Staff may be in hallways. Someone may be in the bathroom, cafeteria, office, stairwell, gym, or between zones. A hallway can become crowded. An exit can become unsafe. A route that works for the majority may fail the person who starts from the wrong place at the wrong time.</p><p class=\"font-semibold text-slate-950\">Static plans protect the average scenario. Valkor is being designed for the variables.</p></div></div></section><section class=\"bg-white px-5 py-16 sm:px-6 lg:px-8 lg:py-24\"><div class=\"mx-auto max-w-7xl\"><div class=\"mx-auto max-w-3xl text-center\"><p class=\"text-sm font-bold uppercase text-orange-700\">Current and Future</p><h2 class=\"mt-3 text-3xl font-semibold sm:text-5xl text-slate-950\">The boundary is part of the product.</h2><p class=\"mt-5 text-lg leading-8 text-slate-600\">Valkor keeps a clear line between what is active today, what is being built toward, and what must be separately approved before emergency use.</p></div><div class=\"mt-12 grid gap-5 lg:grid-cols-2\"><article class=\"rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60 sm:p-8\"><div class=\"flex h-12 w-12 items-center justify-center rounded-2xl border border-emerald-200 bg-emerald-50 text-emerald-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check h-6 w-6\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg></div><h3 class=\"mt-6 text-3xl font-semibold text-slate-950\">Where Valkor starts</h3><p class=\"mt-4 text-base leading-7 text-slate-600\">Valkor begins with school-controlled operational awareness: approved badges, school-defined zones, active passes, receiver or anchor health, stale-data handling, confidence levels, and admin-reviewed incidents.</p></article><article class=\"rounded-[2rem] border border-orange-200 bg-orange-50 p-6 shadow-sm shadow-orange-100/60 sm:p-8\"><div class=\"flex h-12 w-12 items-center justify-center rounded-2xl border border-orange-200 bg-white text-orange-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-git-branch h-6 w-6\" aria-hidden=\"true\"><line x1=\"6\" x2=\"6\" y1=\"3\" y2=\"15\"></line><circle cx=\"18\" cy=\"6\" r=\"3\"></circle><circle cx=\"6\" cy=\"18\" r=\"3\"></circle><path d=\"M18 9a9 9 0 0 1-9 9\"></path></svg></div><h3 class=\"mt-6 text-3xl font-semibold text-slate-950\">Where Valkor is going</h3><p class=\"mt-4 text-base leading-7 text-slate-700\">Over time, that foundation can support emergency coordination tools such as hazard marking, blocked-path awareness, congestion visibility, staff assignments, drill replay, live accountability, and dynamic route recommendations.</p></article></div></div></section><section class=\"bg-slate-950 px-5 py-16 text-white sm:px-6 lg:px-8 lg:py-24\"><div class=\"mx-auto max-w-7xl\"><div class=\"mx-auto max-w-3xl text-center\"><p class=\"text-sm font-bold uppercase text-orange-300\">Three Variables</p><h2 class=\"mt-3 text-3xl font-semibold sm:text-5xl text-white\">Emergency intelligence has to admit what changed.</h2><p class=\"mt-5 text-lg leading-8 text-slate-300\">The future emergency layer is built around three practical questions: what is happening, what is blocked or crowded, and what should an authorized adult do next?</p></div><div class=\"mt-12 grid gap-5 md:grid-cols-3\"><article class=\"rounded-[1.5rem] border p-6 border-white/10 bg-white/5 text-white\"><div class=\"flex h-11 w-11 items-center justify-center rounded-2xl bg-white/10 text-orange-300\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clock h-5 w-5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><polyline points=\"12 6 12 12 16 14\"></polyline></svg></div><h3 class=\"mt-5 text-xl font-semibold\">Time</h3><p class=\"mt-3 text-sm leading-6 text-slate-300\">In fast-moving events, school leaders need faster awareness, fewer blind spots, and clearer next actions.</p></article><article class=\"rounded-[1.5rem] border p-6 border-white/10 bg-white/5 text-white\"><div class=\"flex h-11 w-11 items-center justify-center rounded-2xl bg-white/10 text-orange-300\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users h-5 w-5\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"></path></svg></div><h3 class=\"mt-5 text-xl font-semibold\">Bottlenecks</h3><p class=\"mt-3 text-sm leading-6 text-slate-300\">A safe route is not only the closest route. Hallways, stairwells, doorways, and exits have real capacity limits.</p></article><article class=\"rounded-[1.5rem] border p-6 border-white/10 bg-white/5 text-white\"><div class=\"flex h-11 w-11 items-center justify-center rounded-2xl bg-white/10 text-orange-300\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-gauge h-5 w-5\" aria-hidden=\"true\"><path d=\"m12 14 4-4\"></path><path d=\"M3.34 19a10 10 0 1 1 17.32 0\"></path></svg></div><h3 class=\"mt-5 text-xl font-semibold\">Awareness</h3><p class=\"mt-3 text-sm leading-6 text-slate-300\">The system should show what is fresh, likely, stale, uncertain, or unknown before anyone treats it as truth.</p></article></div></div></section><section class=\"bg-white px-5 py-16 sm:px-6 lg:px-8 lg:py-24\"><div class=\"mx-auto max-w-7xl\"><div class=\"mx-auto max-w-3xl text-center\"><p class=\"text-sm font-bold uppercase text-orange-700\">Dynamic Routing</p><h2 class=\"mt-3 text-3xl font-semibold sm:text-5xl text-slate-950\">Not the shortest path. The safest available decision.</h2><p class=\"mt-5 text-lg leading-8 text-slate-600\">A future routing engine would reason across changing building conditions, school rules, and uncertainty before recommending action.</p></div><div class=\"mt-12 rounded-[2rem] border border-slate-200 bg-[#f5f5f7] p-4 shadow-sm shadow-slate-200/60 sm:p-6 lg:p-8\"><div class=\"grid gap-3 md:grid-cols-5\"><div class=\"flex min-h-28 flex-col justify-between rounded-[1.25rem] border border-slate-200 bg-white p-4 shadow-sm shadow-slate-200/60\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pinned h-5 w-5 text-cyan-700\" aria-hidden=\"true\"><path d=\"M18 8c0 3.613-3.869 7.429-5.393 8.795a1 1 0 0 1-1.214 0C9.87 15.429 6 11.613 6 8a6 6 0 0 1 12 0\"></path><circle cx=\"12\" cy=\"8\" r=\"2\"></circle><path d=\"M8.714 14h-3.71a1 1 0 0 0-.948.683l-2.004 6A1 1 0 0 0 3 22h18a1 1 0 0 0 .948-1.316l-2-6a1 1 0 0 0-.949-.684h-3.712\"></path></svg><p class=\"mt-4 text-sm font-semibold leading-5 text-slate-950\">Building signals</p></div><div class=\"flex min-h-28 flex-col justify-between rounded-[1.25rem] border border-slate-200 bg-white p-4 shadow-sm shadow-slate-200/60\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-route h-5 w-5 text-cyan-700\" aria-hidden=\"true\"><circle cx=\"6\" cy=\"19\" r=\"3\"></circle><path d=\"M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15\"></path><circle cx=\"18\" cy=\"5\" r=\"3\"></circle></svg><p class=\"mt-4 text-sm font-semibold leading-5 text-slate-950\">Zone awareness</p></div><div class=\"flex min-h-28 flex-col justify-between rounded-[1.25rem] border border-slate-200 bg-white p-4 shadow-sm shadow-slate-200/60\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-gauge h-5 w-5 text-cyan-700\" aria-hidden=\"true\"><path d=\"m12 14 4-4\"></path><path d=\"M3.34 19a10 10 0 1 1 17.32 0\"></path></svg><p class=\"mt-4 text-sm font-semibold leading-5 text-slate-950\">Confidence and freshness</p></div><div class=\"flex min-h-28 flex-col justify-between rounded-[1.25rem] border border-slate-200 bg-white p-4 shadow-sm shadow-slate-200/60\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clipboard-check h-5 w-5 text-cyan-700\" aria-hidden=\"true\"><rect width=\"8\" height=\"4\" x=\"8\" y=\"2\" rx=\"1\" ry=\"1\"></rect><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"></path><path d=\"m9 14 2 2 4-4\"></path></svg><p class=\"mt-4 text-sm font-semibold leading-5 text-slate-950\">School context</p></div><div class=\"flex min-h-28 flex-col justify-between rounded-[1.25rem] border border-slate-200 bg-white p-4 shadow-sm shadow-slate-200/60\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-user-check h-5 w-5 text-cyan-700\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><polyline points=\"16 11 18 13 22 9\"></polyline></svg><p class=\"mt-4 text-sm font-semibold leading-5 text-slate-950\">Human action</p></div></div><div class=\"mt-6 grid gap-5 lg:grid-cols-2\"><div class=\"rounded-[1.5rem] border border-slate-200 bg-white p-6\"><h3 class=\"text-xl font-semibold text-slate-950\">A future model could evaluate</h3><div class=\"mt-5 flex flex-wrap gap-2\"><span class=\"inline-flex items-center rounded-full border px-3.5 py-1.5 text-sm font-semibold border-slate-200 bg-white text-slate-700 shadow-sm shadow-slate-200/50\">Believed zone</span><span class=\"inline-flex items-center rounded-full border px-3.5 py-1.5 text-sm font-semibold border-slate-200 bg-white text-slate-700 shadow-sm shadow-slate-200/50\">Hazard zones</span><span class=\"inline-flex items-center rounded-full border px-3.5 py-1.5 text-sm font-semibold border-slate-200 bg-white text-slate-700 shadow-sm shadow-slate-200/50\">Blocked paths</span><span class=\"inline-flex items-center rounded-full border px-3.5 py-1.5 text-sm font-semibold border-slate-200 bg-white text-slate-700 shadow-sm shadow-slate-200/50\">Congestion</span><span class=\"inline-flex items-center rounded-full border px-3.5 py-1.5 text-sm font-semibold border-slate-200 bg-white text-slate-700 shadow-sm shadow-slate-200/50\">Exit capacity</span><span class=\"inline-flex items-center rounded-full border px-3.5 py-1.5 text-sm font-semibold border-slate-200 bg-white text-slate-700 shadow-sm shadow-slate-200/50\">Staff availability</span><span class=\"inline-flex items-center rounded-full border px-3.5 py-1.5 text-sm font-semibold border-slate-200 bg-white text-slate-700 shadow-sm shadow-slate-200/50\">Confidence level</span><span class=\"inline-flex items-center rounded-full border px-3.5 py-1.5 text-sm font-semibold border-slate-200 bg-white text-slate-700 shadow-sm shadow-slate-200/50\">Freshness</span></div></div><div class=\"rounded-[1.5rem] border border-slate-200 bg-white p-6\"><h3 class=\"text-xl font-semibold text-slate-950\">Then recommend reviewable actions</h3><div class=\"mt-5 flex flex-wrap gap-2\"><span class=\"inline-flex items-center rounded-full border px-3.5 py-1.5 text-sm font-semibold border-orange-200 bg-orange-50 text-orange-800\">Shelter</span><span class=\"inline-flex items-center rounded-full border px-3.5 py-1.5 text-sm font-semibold border-orange-200 bg-orange-50 text-orange-800\">Evacuate</span><span class=\"inline-flex items-center rounded-full border px-3.5 py-1.5 text-sm font-semibold border-orange-200 bg-orange-50 text-orange-800\">Hold movement</span><span class=\"inline-flex items-center rounded-full border px-3.5 py-1.5 text-sm font-semibold border-orange-200 bg-orange-50 text-orange-800\">Avoid a corridor</span><span class=\"inline-flex items-center rounded-full border px-3.5 py-1.5 text-sm font-semibold border-orange-200 bg-orange-50 text-orange-800\">Assign staff</span><span class=\"inline-flex items-center rounded-full border px-3.5 py-1.5 text-sm font-semibold border-orange-200 bg-orange-50 text-orange-800\">Verify unknown zones</span></div></div></div><p class=\"mt-6 rounded-[1.5rem] border border-cyan-200 bg-cyan-50 p-5 text-sm font-semibold leading-6 text-slate-800\">Valkor should never pretend uncertain information is certain. Confirmed, likely, weak, uncertain, stale, and unknown states are part of safety because false confidence can create risk.</p></div></div></section><section class=\"border-y border-slate-200 bg-[#f5f5f7] px-5 py-16 sm:px-6 lg:px-8 lg:py-24\"><div class=\"mx-auto max-w-7xl\"><div class=\"mx-auto max-w-3xl text-center\"><p class=\"text-sm font-bold uppercase text-orange-700\">The Road Ahead</p><h2 class=\"mt-3 text-3xl font-semibold sm:text-5xl text-slate-950\">A roadmap, not a day-one promise.</h2><p class=\"mt-5 text-lg leading-8 text-slate-600\">Future emergency coordination only makes sense after the daily operational layer proves reliable, useful, and trusted.</p></div><div class=\"mt-12 grid gap-4 lg:grid-cols-4\"><article class=\"rounded-[1.5rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60\"><p class=\"text-sm font-bold uppercase text-orange-700\">Phase 1</p><h3 class=\"mt-4 text-xl font-semibold text-slate-950\">Operational foundation</h3><p class=\"mt-3 text-sm leading-6 text-slate-600\">Zone awareness, approved badges, active passes, stale-data handling, confidence levels, receiver health, and admin-reviewed incidents.</p></article><article class=\"rounded-[1.5rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60\"><p class=\"text-sm font-bold uppercase text-orange-700\">Phase 2</p><h3 class=\"mt-4 text-xl font-semibold text-slate-950\">Reliability and proof</h3><p class=\"mt-3 text-sm leading-6 text-slate-600\">Calibration, false-alert reduction, drill data, ground-truth testing, coverage review, confidence validation, and pilot reports.</p></article><article class=\"rounded-[1.5rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60\"><p class=\"text-sm font-bold uppercase text-orange-700\">Phase 3</p><h3 class=\"mt-4 text-xl font-semibold text-slate-950\">Emergency readiness</h3><p class=\"mt-3 text-sm leading-6 text-slate-600\">School graph modeling, hazard zones, safe zones, blocked paths, accountability views, staff coordination, and emergency timelines.</p></article><article class=\"rounded-[1.5rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60\"><p class=\"text-sm font-bold uppercase text-orange-700\">Phase 4</p><h3 class=\"mt-4 text-xl font-semibold text-slate-950\">Dynamic coordination</h3><p class=\"mt-3 text-sm leading-6 text-slate-600\">Future route recommendations, congestion-aware routing, hazard-aware movement guidance, live accountability, and after-action intelligence.</p></article></div></div></section><section id=\"future-boundary\" class=\"bg-white px-5 py-16 sm:px-6 lg:px-8 lg:py-24\"><div class=\"mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.82fr_1.18fr] lg:items-start\"><div><p class=\"text-sm font-bold uppercase text-orange-700\">Future Capability Boundary</p><h2 class=\"mt-3 text-4xl font-semibold sm:text-6xl\">Designed to support people, not replace them.</h2><p class=\"mt-6 text-lg leading-8 text-slate-600\">Dynamic emergency routing is a future capability, not a default active feature. Any emergency-routing, advanced-location, hazard-aware movement, or emergency-command capability would require separate school approval, testing, documentation, training, privacy review, and governance before use.</p></div><div class=\"rounded-[2rem] border border-slate-200 bg-slate-950 p-6 text-white shadow-[0_34px_100px_rgba(15,23,42,0.16)] sm:p-8\"><div class=\"flex items-start gap-4\"><div class=\"flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white/10 text-orange-300\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check h-6 w-6\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg></div><div><h3 class=\"text-2xl font-semibold\">What Valkor does not do</h3><p class=\"mt-3 text-sm leading-6 text-slate-300\">Valkor supports trained decision-makers with clearer building awareness. It does not make final emergency decisions for schools.</p></div></div><div class=\"mt-6 flex flex-wrap gap-2\"><span class=\"inline-flex items-center rounded-full border px-3.5 py-1.5 text-sm font-semibold border-white/15 bg-white/[0.08] text-slate-100\">No GPS tracking</span><span class=\"inline-flex items-center rounded-full border px-3.5 py-1.5 text-sm font-semibold border-white/15 bg-white/[0.08] text-slate-100\">No home tracking</span><span class=\"inline-flex items-center rounded-full border px-3.5 py-1.5 text-sm font-semibold border-white/15 bg-white/[0.08] text-slate-100\">No cameras</span><span class=\"inline-flex items-center rounded-full border px-3.5 py-1.5 text-sm font-semibold border-white/15 bg-white/[0.08] text-slate-100\">No microphones</span><span class=\"inline-flex items-center rounded-full border px-3.5 py-1.5 text-sm font-semibold border-white/15 bg-white/[0.08] text-slate-100\">No facial recognition</span><span class=\"inline-flex items-center rounded-full border px-3.5 py-1.5 text-sm font-semibold border-white/15 bg-white/[0.08] text-slate-100\">No biometrics</span><span class=\"inline-flex items-center rounded-full border px-3.5 py-1.5 text-sm font-semibold border-white/15 bg-white/[0.08] text-slate-100\">No student phone monitoring</span><span class=\"inline-flex items-center rounded-full border px-3.5 py-1.5 text-sm font-semibold border-white/15 bg-white/[0.08] text-slate-100\">No automatic discipline</span><span class=\"inline-flex items-center rounded-full border px-3.5 py-1.5 text-sm font-semibold border-white/15 bg-white/[0.08] text-slate-100\">No autonomous emergency control</span><span class=\"inline-flex items-center rounded-full border px-3.5 py-1.5 text-sm font-semibold border-white/15 bg-white/[0.08] text-slate-100\">No guaranteed emergency outcomes</span></div><div class=\"mt-6 grid gap-3 sm:grid-cols-2\"><div class=\"rounded-[1.25rem] border border-white/10 bg-white/5 p-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-triangle-alert h-5 w-5 text-orange-300\" aria-hidden=\"true\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"></path><path d=\"M12 9v4\"></path><path d=\"M12 17h.01\"></path></svg><p class=\"mt-3 text-sm font-semibold leading-6 text-white\">Emergency routing should not be treated as active, validated functionality today.</p></div><div class=\"rounded-[1.25rem] border border-white/10 bg-white/5 p-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-lock-keyhole h-5 w-5 text-orange-300\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"16\" r=\"1\"></circle><rect x=\"3\" y=\"10\" width=\"18\" height=\"12\" rx=\"2\"></rect><path d=\"M7 10V7a5 5 0 0 1 10 0v3\"></path></svg><p class=\"mt-3 text-sm font-semibold leading-6 text-white\">Current Valkor remains school-controlled, zone-level operational awareness.</p></div></div></div></div></section><section class=\"bg-[#f5f5f7] px-5 py-16 sm:px-6 lg:px-8 lg:py-24\"><div class=\"mx-auto grid max-w-7xl gap-8 rounded-[2rem] bg-white p-6 shadow-sm shadow-slate-200/60 sm:p-8 lg:grid-cols-[1fr_auto] lg:items-center\"><div><p class=\"text-sm font-bold uppercase text-cyan-700\">Limited Pilot Review</p><h2 class=\"mt-3 text-3xl font-semibold text-slate-950 sm:text-5xl\">Build the foundation first. Prove it before anything expands.</h2><p class=\"mt-4 max-w-3xl text-base leading-7 text-slate-600\">Pilot reviews focus on reliability, usefulness, privacy comfort, school governance, infrastructure readiness, and clear end-of-pilot reporting.</p></div><a class=\"inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition duration-300 focus:outline-none focus:ring-2 focus:ring-orange-500/70 focus:ring-offset-2 focus:ring-white border border-orange-500/20 bg-orange-600 text-white shadow-lg shadow-orange-600/20 hover:bg-orange-700 hover:shadow-xl hover:shadow-orange-600/25 active:translate-y-px \" href=\"/#request-pilot\">Request Pilot Review<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></section></main><footer class=\"border-t border-slate-200/80 bg-[linear-gradient(180deg,#ffffff_0%,#f8fafc_100%)] px-5 py-12 sm:px-6 lg:px-8\"><div class=\"mx-auto flex max-w-7xl flex-col gap-8 lg:flex-row lg:items-start lg:justify-between\"><div><img alt=\"Valkor Systems\" loading=\"lazy\" width=\"170\" height=\"49\" decoding=\"async\" data-nimg=\"1\" class=\"h-9 w-auto object-contain\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fvalkor-logo.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fvalkor-logo.png&amp;w=384&amp;q=75 2x\" src=\"/_next/image?url=%2Fvalkor-logo.png&amp;w=384&amp;q=75\"/><p class=\"mt-4 max-w-md text-sm leading-6 text-slate-600\">School-controlled operational awareness for pass accountability, attendance reconciliation, incident workflow, staff response, confidence, and audit records.</p><p class=\"mt-2 max-w-md text-sm font-semibold leading-6 text-slate-700\">Currently accepting pilot applications - Virginia and East Coast schools.</p><p class=\"mt-3 text-sm text-slate-600\">Contact:<!-- --> <a class=\"font-medium text-slate-950 transition hover:text-valkor-orange\" href=\"mailto:jackson@valkorsystems.com\">jackson@valkorsystems.com</a></p></div><div class=\"flex flex-wrap gap-x-6 gap-y-3 lg:justify-end\"><a class=\"text-sm font-medium text-slate-600 transition hover:text-slate-950\" href=\"/pilot\">Pilot Program</a><a class=\"text-sm font-medium text-slate-600 transition hover:text-slate-950\" href=\"/trust-center\">Trust Center</a><a class=\"text-sm font-medium text-slate-600 transition hover:text-slate-950\" href=\"/it-security\">IT &amp; Security</a><a class=\"text-sm font-medium text-slate-600 transition hover:text-slate-950\" href=\"/resources\">Resources</a></div></div><div class=\"mx-auto mt-8 max-w-7xl border-t border-slate-200/80 pt-6 text-sm text-slate-500\">© <!-- -->2026<!-- --> Valkor Systems. All rights reserved.</div></footer><!--$--><!--/$--><script src=\"/_next/static/chunks/webpack-72c1bf8cb8877324.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[9766,[],\\\"\\\"]\\n3:I[8924,[],\\\"\\\"]\\n4:I[1725,[\\\"724\\\",\\\"static/chunks/724-cf65792c48e33df3.js\\\",\\\"725\\\",\\\"static/chunks/725-102a69bb248c73da.js\\\",\\\"945\\\",\\\"static/chunks/app/future-emergency-readiness/page-e4b4c03c0a1c54b5.js\\\"],\\\"Header\\\"]\\n5:I[2619,[\\\"724\\\",\\\"static/chunks/724-cf65792c48e33df3.js\\\",\\\"725\\\",\\\"static/chunks/725-102a69bb248c73da.js\\\",\\\"945\\\",\\\"static/chunks/app/future-emergency-readiness/page-e4b4c03c0a1c54b5.js\\\"],\\\"\\\"]\\n13:I[7150,[],\\\"\\\"]\\n:HL[\\\"/_next/static/media/e4af272ccee01ff0-s.p.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/css/7bc07c4560c01387.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"0:{\\\"P\\\":null,\\\"b\\\":\\\"HaFh2Yy5IRsIyBrFFSb3G\\\",\\\"p\\\":\\\"\\\",\\\"c\\\":[\\\"\\\",\\\"future-emergency-readiness\\\"],\\\"i\\\":false,\\\"f\\\":[[[\\\"\\\",{\\\